<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>

		<!-- PublishAot writes IsDynamicCodeSupported=false into runtimeconfig.json, which breaks the Avalonia previewer -->
		<PublishAot Condition="'$(Configuration)' == 'Release'">True</PublishAot>
		<TrimMode>full</TrimMode>
		<StripSymbols>true</StripSymbols>
		<InvariantGlobalization>false</InvariantGlobalization>
		<CETCompat>false</CETCompat>
		<PublishSelfContained>True</PublishSelfContained>

		<ApplicationIcon>Assets\Images\icon-cm-64.ico</ApplicationIcon>

		<FileVersion>2.1</FileVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<OutputType>WinExe</OutputType>
		<DebugType>portable</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<OutputType>WinExe</OutputType>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<AvaloniaResource Include="..\THIRD-PARTY-NOTICES.txt" Link="Assets\THIRD-PARTY-NOTICES.txt" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CollectiveModdingToolkit.Tests" />
	</ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="Avalonia" />
		<TrimmerRootAssembly Include="Semi.Avalonia" />
		<TrimmerRootAssembly Include="CommunityToolkit.Mvvm" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.6" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
		<PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.6" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="11.0.0" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
		<PackageReference Include="ini-parser-netstandard" Version="2.5.3" />
		<PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
		<PackageReference Include="Semi.Avalonia.ColorPicker" Version="12.1.0.1" />
		<PackageReference Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
		<PackageReference Include="System.IO.Hashing" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CollectiveModdingToolkit.Delta\CollectiveModdingToolkit.Delta.csproj" />
		<ProjectReference Include="..\CollectiveModdingToolkit.Materials\CollectiveModdingToolkit.Materials.csproj" />
	</ItemGroup>

	<!-- THIRD-PARTY-NOTICES.txt is generated from the packages in use. Warn (offline, no network) when it has gone stale. -->
	<Target Name="CheckThirdPartyNotices" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
		<Exec Command="dotnet run --file &quot;$(MSBuildThisFileDirectory)..\tools\GenerateThirdPartyNotices.cs&quot; -- --check"
			  IgnoreExitCode="true"
			  IgnoreStandardErrorWarningFormat="true"
			  StandardOutputImportance="low"
			  StandardErrorImportance="low">
			<Output TaskParameter="ExitCode" PropertyName="NoticesCheckExitCode" />
		</Exec>
		<Warning Condition="'$(NoticesCheckExitCode)' != '0'"
				 Text="THIRD-PARTY-NOTICES.txt is out of date with the packages in use. Regenerate it: dotnet run tools/GenerateThirdPartyNotices.cs" />
	</Target>

	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<Exec Command="taskkill /f /fi &quot;imagename eq $(TargetName).exe&quot;" />
	</Target>
</Project>
