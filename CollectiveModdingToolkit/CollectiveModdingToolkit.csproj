<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>

		<PublishTrimmed>False</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<CETCompat>false</CETCompat>
		<PublishSelfContained>True</PublishSelfContained>
		<PublishSingleFile>True</PublishSingleFile>

		<ApplicationIcon>Assets\Images\icon-cm-64.ico</ApplicationIcon>

		<FileVersion>0.1</FileVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<OutputType>WinExe</OutputType>
		<DebugType>portable</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<OutputType>WinExe</OutputType>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<!--<Content Include="Assets\Images\icon-64.ico" />
		<Content Include="Assets\Images\icon-cm-64.ico" />-->
	</ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="Avalonia" />
		<TrimmerRootAssembly Include="Avalonia.Markup.Xaml.Loader" />
		<TrimmerRootAssembly Include="Avalonia.DesignerSupport" />
		<TrimmerRootAssembly Include="Semi.Avalonia" />
		<TrimmerRootAssembly Include="CommunityToolkit.Mvvm" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.6" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
		<PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.6" />
		<PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="11.0.0" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
		<PackageReference Include="ini-parser-netstandard" Version="2.5.3" />
		<PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
		<PackageReference Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
		<PackageReference Include="System.IO.Hashing" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Views\TabScanner.axaml.cs">
			<DependentUpon>TabScanner.axaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<Exec Command="taskkill /f /fi &quot;imagename eq $(TargetName).exe&quot;" />
	</Target>
</Project>
