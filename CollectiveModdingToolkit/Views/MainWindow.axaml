<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:m="using:CollectiveModdingToolkit.Models"
		xmlns:v="using:CollectiveModdingToolkit.Views"
		xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
		xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
		mc:Ignorable="d"
		d:DesignWidth="760"
		d:DesignHeight="450"
		x:Class="CollectiveModdingToolkit.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		x:CompileBindings="True"
		Icon="/Assets/Images/icon-cm-64.png"
		Title="{Binding WindowTitle}"
		Width="760"
		Height="450"
		MinWidth="760"
		MinHeight="450"
		WindowStartupLocation="CenterScreen">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<dialogHost:DialogHost Identifier="CriticalErrorDialog"
						   CloseOnClickAway="False"
						   Loaded="DialogHost_Loaded"
						   IsOpen="{Binding Computer.CriticalErrorOpen}">
		<dialogHost:DialogHost.DialogContent>
			<Border Name="CriticalErrorContent">
				<TextBlock TextWrapping="Wrap">
					<Run Text="Critical Error"
						 Classes="Bad" />
					<LineBreak />
					<Run Text="{Binding Computer.ErrorMessage}" />
				</TextBlock>
			</Border>
		</dialogHost:DialogHost.DialogContent>

		<TabControl>
			<TabItem Header="Overview">
				<v:TabOverview />
			</TabItem>
			<TabItem Header="F4SE">
				<v:TabF4SE />
			</TabItem>
			<TabItem Header="Scanner">
				<v:TabScanner />
			</TabItem>
			<TabItem Header="Tools">
				<v:TabTools />
			</TabItem>
			<TabItem Header="Settings">
				<v:TabSettings />
			</TabItem>
			<TabItem Header="About">
				<v:TabAbout />
			</TabItem>
		</TabControl>
	</dialogHost:DialogHost>
</Window>
