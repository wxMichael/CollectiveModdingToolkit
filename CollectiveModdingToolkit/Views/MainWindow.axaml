<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="using:CollectiveModdingToolkit.Views"
        xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="500"
        x:Class="CollectiveModdingToolkit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Icon="/Assets/Images/icon-cm-64.png"
        Title="{Binding WindowTitle}"
        Width="800"
        Height="500"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

	<dialogHost:DialogHost Identifier="CriticalErrorDialog"
	                       CloseOnClickAway="False"
	                       Loaded="DialogHost_Loaded"
	                       IsOpen="{Binding Errors.IsOpen}">
		<dialogHost:DialogHost.DialogContent>
			<Border Name="CriticalErrorContent" Padding="15">
				<StackPanel Spacing="10">
					<TextBlock TextWrapping="Wrap">
						<Run Text="Critical Error"
						     Classes="Bad" />
						<LineBreak />
						<Run Text="{Binding Errors.Message}" />
					</TextBlock>
					<Button Content="Exit" HorizontalAlignment="Right" Click="Button_Click_Exit" />
				</StackPanel>
			</Border>
		</dialogHost:DialogHost.DialogContent>

		<TabControl>
			<TabItem Header="Overview">
				<v:TabOverview DataContext="{Binding Overview}" />
			</TabItem>
			<TabItem Header="F4SE">
				<v:TabF4SE DataContext="{Binding F4SE}" />
			</TabItem>
			<TabItem Header="Archives">
				<v:TabArchives DataContext="{Binding Archives}" />
			</TabItem>
			<TabItem Header="Modules">
				<v:TabModules />
			</TabItem>
			<TabItem Header="Scanner">
				<v:TabScanner DataContext="{Binding Scanner}" />
			</TabItem>
			<TabItem Header="Downgrader">
				<v:TabDowngrader DataContext="{Binding Downgrader}" />
			</TabItem>
			<TabItem Header="Tools">
				<v:TabTools DataContext="{Binding Tools}" />
			</TabItem>
			<TabItem Header="Settings">
				<v:TabSettings DataContext="{Binding Settings}" />
			</TabItem>
			<TabItem Header="About">
				<v:TabAbout DataContext="{Binding About}" />
			</TabItem>
			<TabItem Header="Update"
			         Classes="Update"
			         Background="{DynamicResource AccentBrush}"
			         IsVisible="{Binding Update.IsUpdateAvailable}">
				<v:TabUpdate DataContext="{Binding Update}" />
			</TabItem>
		</TabControl>
	</dialogHost:DialogHost>
</Window>
