<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
             xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
             xmlns:conv="using:CollectiveModdingToolkit.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="500"
             x:Class="CollectiveModdingToolkit.Views.TabSettings"
             x:DataType="vm:SettingsViewModel">

	<Design.DataContext>
		<vm:SettingsViewModel />
	</Design.DataContext>

	<UserControl.Resources>
		<conv:EnumIsConverter x:Key="EnumIs" />
	</UserControl.Resources>

	<StackPanel Orientation="Horizontal"
	            VerticalAlignment="Top"
	            HorizontalAlignment="Left"
	            Spacing="5">

		<ctrl:GroupBox Header="Log Level">
			<StackPanel Orientation="Vertical"
			            ToolTip.Tip="How much detail is written to the log file. Debug is the most useful when reporting a problem.">
				<RadioButton GroupName="LogLevel"
				             Content="Debug"
				             IsChecked="{Binding Settings.LogLevel, Mode=TwoWay, Converter={StaticResource EnumIs}, ConverterParameter=Debug}" />
				<RadioButton GroupName="LogLevel"
				             Content="Info"
				             IsChecked="{Binding Settings.LogLevel, Mode=TwoWay, Converter={StaticResource EnumIs}, ConverterParameter=Info}" />
				<RadioButton GroupName="LogLevel"
				             Content="Warning"
				             IsChecked="{Binding Settings.LogLevel, Mode=TwoWay, Converter={StaticResource EnumIs}, ConverterParameter=Warning}" />
				<RadioButton GroupName="LogLevel"
				             Content="Error"
				             IsChecked="{Binding Settings.LogLevel, Mode=TwoWay, Converter={StaticResource EnumIs}, ConverterParameter=Error}" />
			</StackPanel>
		</ctrl:GroupBox>

		<ctrl:GroupBox Header="Files">
			<StackPanel Orientation="Vertical"
			            Spacing="5">
				<Button Content="Show Log File"
				        Command="{Binding ShowLogFileCommand}" />
				<Button Content="Show Settings File"
				        Command="{Binding ShowSettingsFileCommand}" />
			</StackPanel>
		</ctrl:GroupBox>

		<ctrl:GroupBox Header="Update Check">
			<StackPanel Orientation="Vertical"
			            Spacing="5"
			            Width="340">
				<CheckBox Content="Check on launch"
				          FontWeight="Normal"
				          IsChecked="{Binding Settings.CheckForUpdates, Mode=TwoWay}"
				          ToolTip.Tip="Check Nexus Mods for a new version when the toolkit starts (at most once every 12 hours)." />
				<Button Content="Check Now"
				        Command="{Binding Update.CheckNowCommand}" />
				<TextBlock Classes="Small"
				           FontWeight="Normal"
				           TextWrapping="Wrap"
				           Text="Checking..."
				           IsVisible="{Binding Update.IsChecking}" />
				<TextBlock Classes="Small"
				           FontWeight="Normal"
				           TextWrapping="Wrap"
				           Text="{Binding Update.StatusMessage}"
				           IsVisible="{Binding Update.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
				<TextBlock Classes="Small Bad"
				           FontWeight="Normal"
				           TextWrapping="Wrap"
				           Text="{Binding Update.ErrorMessage}"
				           IsVisible="{Binding Update.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
			</StackPanel>
		</ctrl:GroupBox>
	</StackPanel>
</UserControl>
