<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:CollectiveModdingToolkit.Models"
             xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
             xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="500"
             x:Class="CollectiveModdingToolkit.Views.TabScanner"
             x:DataType="vm:TabScannerViewModel">

	<Design.DataContext>
		<vm:TabScannerViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="30,*,Auto,150">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220"
			                  MinWidth="170" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*"
			                  MinWidth="150" />
		</Grid.ColumnDefinitions>

		<GridSplitter Grid.Row="0"
		              Grid.Column="1"
		              Grid.RowSpan="4"
		              ResizeDirection="Columns"
		              Background="{DynamicResource StrokeMidBrush}" />

		<!-- Left: mods, or kinds of problem -->
		<Border Grid.Row="0"
		        Grid.Column="0"
		        BorderBrush="{DynamicResource StrokeMidBrush}"
		        BorderThickness="1">
			<StackPanel Orientation="Horizontal"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Spacing="4">
				<StackPanel.Styles>
					<Style Selector="RadioButton">
						<Setter Property="MinHeight" Value="0" />
						<Setter Property="Height" Value="24" />
						<Setter Property="Padding" Value="8,3,8,0" />
						<Setter Property="VerticalContentAlignment" Value="Center" />
					</Style>
					<Style Selector="RadioButton /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="VerticalAlignment" Value="Center" />
						<Setter Property="VerticalContentAlignment" Value="Center" />
					</Style>
					<Style Selector="RadioButton:checked">
						<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
					</Style>
					<Style Selector="RadioButton:checked /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
					</Style>
				</StackPanel.Styles>
				<RadioButton Content="By Problem"
				             Theme="{DynamicResource ButtonRadioButton}"
				             GroupName="ScanGrouping"
				             IsChecked="{Binding GroupByProblem, Mode=TwoWay}"
				             ToolTip.Tip="Group results by kind of problem" />
				<RadioButton Content="By Mod"
				             Theme="{DynamicResource ButtonRadioButton}"
				             GroupName="ScanGrouping"
				             IsChecked="{Binding GroupByMod, Mode=TwoWay}"
				             ToolTip.Tip="Group results by mod" />
			</StackPanel>
		</Border>
		<Border Grid.Row="1"
		        Grid.RowSpan="3"
		        Grid.Column="0"
		        BorderBrush="{DynamicResource StrokeMidBrush}"
		        BorderThickness="1,0,1,1">
			<ListBox ItemsSource="{Binding Groups}"
			         SelectedItem="{Binding SelectedGroup}"
			         Classes="Readable"
			         Padding="0,3,0,0">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Padding"
						        Value="0" />
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:ScanGroup">
						<TextBlock Text="{Binding Label}"
						           Classes="Readable"
						           Foreground="{DynamicResource Neutral2Brush}"
						           Padding="5,0,0,0" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<!-- Right header: title, grouping, settings, scan -->
		<Border Grid.Row="0"
		        Grid.Column="2"
		        BorderBrush="{DynamicResource StrokeMidBrush}"
		        BorderThickness="1">
			<DockPanel LastChildFill="True">
				<StackPanel DockPanel.Dock="Right"
				            Orientation="Horizontal"
				            Spacing="4"
				            Margin="4,0">
					<Button Content="Settings"
					        Classes="Small">
						<Button.Flyout>
							<Flyout Placement="BottomEdgeAlignedRight">
								<StackPanel Spacing="4"
								            Width="260">

									<ctrl:SettingOption Header="Overview Issues"
									                    IsChecked="{Binding Settings.ScanOverviewIssues}"
									                    Description="Report details of issues from Overview." />

									<ctrl:SettingOption Header="Texture Issues"
														IsChecked="{Binding Settings.ScanTextureIssues}"
														Description="Check loose DDS textures for invalid headers and dimensions. Must be a power of 2, or a multiple of 4 for cubemaps." />

									<ctrl:SettingOption Header="Wrong File Formats"
									                    IsChecked="{Binding Settings.ScanWrongFormat}"
									                    Description="Check file types against a whitelist per Data folder, e.g. MP3 instead of XWM/WAV in Data/Sound/." />

									<ctrl:SettingOption Header="Loose Previs"
									                    IsChecked="{Binding Settings.ScanLoosePrevis}"
									                    Description="Report loose Data/Vis/ and Data/Meshes/Precombined/ folders." />

									<ctrl:SettingOption Header="Junk Files"
									                    IsChecked="{Binding Settings.ScanJunkFiles}"
									                    Description="Report junk files such as desktop.ini and Thumbs.db, and leftover fomod folders." />

									<ctrl:SettingOption Header="Problem Overrides"
									                    IsChecked="{Binding Settings.ScanProblemOverrides}"
									                    Description="Check for overrides that typically cause issues, such as outdated F4SE script files or loose AnimTextData folders." />

									<ctrl:SettingOption Header="Race Subgraphs"
									                    IsChecked="{Binding Settings.ScanRaceSubgraphs}"
									                    Description="Counts race animation subgraph records (RACE \ SADD). Adding too many may cause stutter when loading Cells. Base game count: 37. Warning threshold: 100." />

								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>
					<Button Content="Scan"
					        Classes="Small Primary"
					        Width="80"
					        IsVisible="{Binding IsNotProcessing}"
					        Command="{Binding StartScanCommand}" />
					<Button Content="Cancel"
					        Classes="Small Danger"
					        Width="80"
					        IsVisible="{Binding !IsNotProcessing}"
					        Command="{Binding CancelScanCommand}" />
				</StackPanel>
				<TextBlock Text="☢ Potential Issues ☢"
				           Margin="5,0"
				           VerticalAlignment="Center"
				           HorizontalAlignment="Center" />
			</DockPanel>
		</Border>

		<!-- Issues for the selected group -->
		<Border Grid.Row="1"
		        Grid.Column="2"
		        BorderBrush="{DynamicResource StrokeMidBrush}"
		        BorderThickness="1,0">
			<Grid>
				<ListBox ItemsSource="{Binding Issues}"
				         SelectedItem="{Binding SelectedRow}"
				         Classes="Readable">
					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Padding"
							        Value="0" />
						</Style>
					</ListBox.Styles>
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ScanRow">
							<Grid ColumnDefinitions="1.6*,1*"
							      Margin="5,0">
								<TextBlock Grid.Column="0"
								           Classes="Readable"
								           ctrl:Status.Level="{Binding Level}"
								           Text="{Binding Title}" />
								<TextBlock Grid.Column="1"
								           Classes="Readable"
								           ctrl:Status.Level="{Binding Level}"
								           Text="{Binding Secondary}" />
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<TextBlock Classes="Readable Neutral"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           Text="{Binding ResultsInfo}"
				           IsVisible="{Binding !Groups.Count}" />
			</Grid>
		</Border>

		<!-- Progress while scanning -->
		<StackPanel Grid.Row="2"
		            Grid.Column="2"
		            Margin="5,2"
		            IsVisible="{Binding !IsNotProcessing}">
			<TextBlock Classes="Readable"
			           Text="{Binding StatusText}" />
			<ProgressBar Minimum="0"
			             Maximum="100"
			             Value="{Binding Progress}" />
		</StackPanel>

		<!-- Details of the selected issue -->
		<Border Grid.Row="3"
		        Grid.Column="2"
		        BorderBrush="{DynamicResource StrokeMidBrush}"
		        BorderThickness="1"
		        ClipToBounds="True">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Grid.ColumnSpan="2"
				           Classes="Readable Small Neutral"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           Text="▲ Select a mod and issue above ▲"
				           IsVisible="{Binding CurrentIssue, Converter={x:Static ObjectConverters.IsNull}}" />

				<ScrollViewer Grid.Column="0"
				              Margin="10,5,5,0"
				              VerticalScrollBarVisibility="Auto"
				              IsVisible="{Binding CurrentIssue, Converter={x:Static ObjectConverters.IsNotNull}}">
					<Panel DataContext="{Binding CurrentIssue}">
						<Grid ColumnDefinitions="Auto,*"
						      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
						      x:DataType="m:ProblemInfo">
							<Grid.Styles>
								<Style Selector="TextBlock">
									<Setter Property="Margin"
									        Value="0,1" />
									<Setter Property="TextWrapping"
									        Value="Wrap" />
								</Style>
								<Style Selector="TextBlock.Label">
									<Setter Property="Margin"
									        Value="0,1,8,1" />
									<Setter Property="TextAlignment"
									        Value="Right" />
								</Style>
							</Grid.Styles>

							<TextBlock Grid.Row="0"
							           Grid.Column="0"
							           Classes="Small Label"
							           Text="File:" />
							<TextBlock Grid.Row="0"
							           Grid.Column="1"
							           Classes="Small"
							           Text="{Binding DisplayName}" />

							<TextBlock Grid.Row="1"
							           Grid.Column="0"
							           Classes="Small Label"
							           Text="Mod:" />
							<TextBlock Grid.Row="1"
							           Grid.Column="1"
							           Classes="Small"
							           Text="{Binding Mod, TargetNullValue='N/A'}" />

							<TextBlock Grid.Row="2"
							           Grid.Column="0"
							           Classes="Small Label"
							           Text="Location:" />
							<TextBlock Grid.Row="2"
							           Grid.Column="1"
							           Classes="Small"
							           Text="{Binding RelativePath}"
							           Cursor="Hand"
							           ToolTip.Tip="Click to open location"
							           IsVisible="{Binding HasPath}"
							           PointerPressed="Pointer_Pressed_OpenLocation" />

							<TextBlock Grid.Row="3"
							           Grid.Column="0"
							           Classes="Small Label"
							           Text="Summary:" />
							<TextBlock Grid.Row="3"
							           Grid.Column="1"
							           Classes="Small"
							           Text="{Binding Summary}" />

							<TextBlock Grid.Row="4"
							           Grid.Column="0"
							           Classes="Small Label"
							           Text="Solution:" />
							<StackPanel Grid.Row="4"
							            Grid.Column="1">
								<TextBlock Classes="Small"
								           Text="{Binding Solution, TargetNullValue='No solution suggestion.'}" />
								<TextBlock Classes="Small"
								           Text="{Binding Url}"
								           Cursor="Hand"
								           TextDecorations="Underline"
								           ToolTip.Tip="Left-Click: Open URL&#10;Right-Click: Copy URL"
								           IsVisible="{Binding Url, Converter={x:Static ObjectConverters.IsNotNull}}"
								           PointerPressed="Pointer_Pressed_Url" />
							</StackPanel>
						</Grid>
					</Panel>
				</ScrollViewer>

				<Border Grid.Column="1"
				        Padding="5"
				        BorderBrush="{DynamicResource StrokeMidBrush}"
				        BorderThickness="1,0,0,0"
				        IsVisible="{Binding CurrentIssue, Converter={x:Static ObjectConverters.IsNotNull}}">
					<StackPanel Spacing="5"
					            Width="100">
						<Button Content="Copy Details"
						        Classes="Small"
						        HorizontalAlignment="Stretch"
						        Command="{Binding CopyDetailsCommand}" />
						<Button Content="File List"
						        Classes="Small"
						        HorizontalAlignment="Stretch"
						        IsVisible="{Binding CurrentIssue.FileList, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
						        Command="{Binding ShowFileListCommand}" />
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</Grid>
</UserControl>
