<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
             xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="500"
             x:Class="CollectiveModdingToolkit.Views.TabTools"
             x:DataType="vm:ToolsViewModel">

	<Design.DataContext>
		<vm:ToolsViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="ctrl|GroupBox.CenteredHeader /template/ TextBlock#GBHeaderText">
			<Setter Property="Grid.ColumnSpan"
			        Value="2" />
			<Setter Property="HorizontalAlignment"
			        Value="Center" />
		</Style>

		<Style Selector="StackPanel.ToolBox">
			<Setter Property="Spacing"
			        Value="5" />
		</Style>

		<Style Selector="StackPanel.ToolBox, Grid.ToolBox">
			<Setter Property="Margin"
			        Value="5" />
			<Style Selector="^ Button">
				<Setter Property="HorizontalAlignment"
				        Value="Stretch" />
				<Setter Property="Margin"
				        Value="0,5,0,0" />
				<Setter Property="FontSize"
				        Value="{StaticResource Smaller}" />

				<Style Selector="^ > AccessText">
					<Setter Property="TextWrapping"
					        Value="Wrap" />
					<Setter Property="TextAlignment"
					        Value="Center" />
				</Style>
			</Style>

			<Style Selector="^ Image.Info">
				<Setter Property="MaxWidth"
				        Value="16" />
				<Setter Property="MaxHeight"
				        Value="16" />
				<Setter Property="HorizontalAlignment"
				        Value="Center" />
				<Setter Property="VerticalAlignment"
				        Value="Center" />
				<Setter Property="Margin"
				        Value="5,5,0,0" />
				<Setter Property="ToolTip.Placement"
				        Value="Right" />
			</Style>
		</Style>

		<Style Selector="ctrl|GroupBox > StackPanel">
			<Setter Property="Margin"
			        Value="5" />
			<Setter Property="Spacing"
			        Value="5" />
		</Style>
	</UserControl.Styles>

	<UniformGrid Rows="1"
	             Columns="3">

		<!-- Toolkit Utilities -->
		<ctrl:GroupBox Classes="CenteredHeader"
		               Header="Toolkit Utilities">
			<StackPanel Classes="ToolBox">

				<Button Content="Tool 1"
				        IsEnabled="False" />
				<!-- 		Click="Button_Click_OpenDowngradeManager" /> -->

				<Button Content="Tool 2"
				        IsEnabled="False" />
				<!-- 		Click="Button_Click_OpenArchivePatcher" /> -->

			</StackPanel>
		</ctrl:GroupBox>

		<!-- Other CM Authors' Tools -->
		<ctrl:GroupBox Classes="CenteredHeader"
		               Header="Other CM Authors' Tools">
			<Grid Classes="ToolBox"
			      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
			      ColumnDefinitions="*,Auto">

				<Button Content="Bethini Pie"
				        Grid.Row="0"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://www.nexusmods.com/site/mods/631" />
				<Image Classes="Info"
				       Grid.Row="0"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Bethini Pie (Performance INI Editor) makes editing INI config files simple.<LineBreak />
							<LineBreak />
							<Bold>Author:</Bold> DoubleYou<LineBreak />
							<Bold>Channel:</Bold> #⚙-bethini-doubleyou-etc
						</TextBlock>
					</ToolTip.Tip>
				</Image>

				<Button Content="CLASSIC Crash Log Scanner"
				        Grid.Row="1"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://www.nexusmods.com/fallout4/mods/56255" />
				<Image Classes="Info"
				       Grid.Row="1"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Scans Buffout crash logs for key indicators of crashes. You can also post crash logs to the CM Discord for assistance.
							<LineBreak />
							<LineBreak />
							<Bold>Authors:</Bold> Poet &amp; evildarkarchon<LineBreak />
							<Bold>Channel:</Bold> #🚨-fo4-crash-logs
						</TextBlock>
					</ToolTip.Tip>
				</Image>

				<Button Content="Vault-Tec Enhanced&#x0d;&#x0a;FaceGen System (VEFS)"
				        Grid.Row="2"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://www.nexusmods.com/fallout4/mods/86374" />
				<Image Classes="Info"
				       Grid.Row="2"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Automates the process of generating FaceGen models and textures with xEdit/CK.<LineBreak />
							<LineBreak />
							<Bold>Author:</Bold> DoubleYou<LineBreak />
							<Bold>Channel:</Bold> #⚙-bethini-doubleyou-etc
						</TextBlock>
					</ToolTip.Tip>
				</Image>

				<Button Content="PJM's Precombine/Previs Patching Scripts"
				        Grid.Row="3"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://www.nexusmods.com/fallout4/mods/69978" />
				<Image Classes="Info"
				       Grid.Row="3"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Scripts to find precombine/previs (flickering/occlusion) errors in your mod list, and optionally generate a patch to fix those problems.
							<LineBreak />
							<LineBreak />
							<Bold>Author:</Bold> PJM<LineBreak />
							<Bold>Channel:</Bold> N/A
						</TextBlock>
					</ToolTip.Tip>
				</Image>

				<Button Content="DDS Texture Scanner"
				        Grid.Row="4"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://www.nexusmods.com/fallout4/mods/71588" />
				<Image Classes="Info"
				       Grid.Row="4"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Sniff out textures that might CTD your game. With BA2 support.<LineBreak />
							<LineBreak />
							<Bold>Author:</Bold> niston<LineBreak />
							<Bold>Channel:</Bold> #🔧-nistonmakemod
						</TextBlock>
					</ToolTip.Tip>
				</Image>

			</Grid>
		</ctrl:GroupBox>

		<!-- Other Useful Tools -->
		<ctrl:GroupBox Classes="CenteredHeader"
		               Header="Other Useful Tools">
			<Grid Classes="ToolBox"
			      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
			      ColumnDefinitions="*,Auto">

				<Button Content="xEdit / FO4Edit"
				        Grid.Row="0"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://github.com/TES5Edit/TES5Edit#xedit" />
				<Image Classes="Info"
				       Grid.Row="0"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Module editor and conflict detector for Bethesda games.<LineBreak />
							<LineBreak />
							<Bold>Note: </Bold>FO4Edit/SSEEdit are xEdit, renamed to auto-set a game mode.<LineBreak />
							<Bold>Authors:</Bold> ElminsterAU and the xEdit Team
						</TextBlock>
					</ToolTip.Tip>
				</Image>

				<Button Content="Creation Kit Platform&#x0d;&#x0a;Extended (CKPE)"
				        Grid.Row="1"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://www.nexusmods.com/fallout4/mods/51165" />
				<Image Classes="Info"
				       Grid.Row="1"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Various patches and bug fixes for the Creation Kit to make life easier.<LineBreak />
							<LineBreak />
							<Bold>Author:</Bold> perchik71
						</TextBlock>
					</ToolTip.Tip>
				</Image>

				<Button Content="Cathedral Assets&#x0d;&#x0a;Optimizer (CAO)"
				        Grid.Row="3"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://www.nexusmods.com/skyrimspecialedition/mods/23316" />
				<Image Classes="Info"
				       Grid.Row="3"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							An automation tool used to optimize BSAs, meshes, textures and animations.<LineBreak />
							<LineBreak />
							<Bold>Author:</Bold>  G'k
						</TextBlock>
					</ToolTip.Tip>
				</Image>

				<Button Content="BA2 Merging Automation&#x0d;&#x0a;Tool (BMAT)"
				        Grid.Row="4"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://www.nexusmods.com/fallout4/mods/89306" />
				<Image Classes="Info"
				       Grid.Row="4"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Automated BA2 files repackaging and merging.<LineBreak />
							<LineBreak />
							<Bold>Author:</Bold> rjshadowface
						</TextBlock>
					</ToolTip.Tip>
				</Image>

				<Button Content="IceStorm's Texture Tools"
				        Grid.Row="5"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://storage.icestormng-mods.de/s/QG43aExydefeGXy" />
				<Image Classes="Info"
				       Grid.Row="5"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Converts textures from various formats into a Fallout 4 compatible format.<LineBreak />
							<LineBreak />
							<Bold>Author:</Bold> IceStormNG
						</TextBlock>
					</ToolTip.Tip>
				</Image>

				<Button Content="CapFrameX"
				        Grid.Row="6"
				        Grid.Column="0"
				        Command="{Binding OpenUrlCommand}"
				        CommandParameter="https://www.capframex.com/" />
				<Image Classes="Info"
				       Grid.Row="6"
				       Grid.Column="1"
				       Source="avares://CollectiveModdingToolkit/Assets/Images/info-32.png">

					<ToolTip.Tip>
						<TextBlock>
							Benchmarking tool - Record FPS, frametime, and sensors; analyse and plot the results.
							<LineBreak />
							<LineBreak />
							<Bold>Authors:</Bold> CapframeX Team
						</TextBlock>
					</ToolTip.Tip>
				</Image>

			</Grid>
		</ctrl:GroupBox>
	</UniformGrid>
</UserControl>
