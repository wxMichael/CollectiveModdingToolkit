<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:m="using:CollectiveModdingToolkit.Models"
		xmlns:v="using:CollectiveModdingToolkit.Views"
		xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
		xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
		mc:Ignorable="d"
		d:DesignWidth="800"
		d:DesignHeight="500"
		x:Class="CollectiveModdingToolkit.Views.ArchivePatcher"
		x:DataType="vm:MainWindowViewModel"
		x:CompileBindings="True"
		Title="Archive Patcher"
		Icon="/Assets/Images/icon-cm-64.png"
		Width="760"
		Height="450"
		MinWidth="760"
		MinHeight="450"
		WindowStartupLocation="CenterOwner">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<StackPanel Orientation="Vertical">
		<Grid RowDefinitions="Auto"
			  ColumnDefinitions="Auto,*,Auto"
			  Margin="10,0,10,0">
			<ctrl:GroupBox Grid.Row="0"
						   Grid.Column="0"
						   Header="Desired Version">

				<StackPanel Orientation="Horizontal">

					<RadioButton GroupName="DesiredVersion"
								 Content="v1 (OG)"
								 Margin="5,0,0,0"
								 IsChecked="True"/>

					<!--<RadioButton GroupName="DesiredVersion"
								 Content="v7 (NG)"
								 Margin="5,0,0,0" />-->

					<RadioButton GroupName="DesiredVersion"
								 Content="v8 (NG)"
								 Margin="5,0,0,0" />
				</StackPanel>
			</ctrl:GroupBox>

			<TextBlock Grid.Row="0"
					   Grid.Column="1"
					   TextAlignment="Center"
					   VerticalAlignment="Center"
					   HorizontalAlignment="Center"
					   Padding="10,0"
					   Classes="Readable Neutral2"
					   Text="Showing all NG archives." />

			<StackPanel Grid.Row="0"
						Grid.Column="2"
						Orientation="Horizontal"
						HorizontalAlignment="Right"
						Spacing="10">

				<Button Content="About"
						MinWidth="90" />

				<Button Content="Patch All"
						Theme="{DynamicResource SolidButton}"
						Classes="Success"
						MinWidth="90" />

			</StackPanel>
		</Grid>
		<DockPanel Margin="0,5">
			<Label DockPanel.Dock="Left"
				   Content="Name Filter:"
				   VerticalAlignment="Center"
				   Margin="5,0,0,0" />

			<TextBox DockPanel.Dock="Left"
					 Margin="5,0,5,0" />
		</DockPanel>

		<!--<ListBox x:Name="archivePatcherList"
				 ItemsSource="{Binding ModManager.ArchivesWinning}"
				 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

			-->
		<!--<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>-->
		<!--

			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Key}"
							   Classes="Readable"
							   Margin="0"
							   Padding="0" />
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>-->

		<DataGrid Name="ArchiveList"
				  DockPanel.Dock="Right"
				  ItemsSource="{Binding ModManager.ArchivesWinning}"
				  AutoGenerateColumns="False"
				  IsReadOnly="True"
				  GridLinesVisibility="All"
				  BorderThickness="1"
				  CanUserResizeColumns="False"
				  CanUserSortColumns="True"
				  BorderBrush="Gray"
				  HorizontalScrollBarVisibility="Disabled">

			<DataGrid.Columns>

				<DataGridTemplateColumn Header="Ver."
										Width="Auto"
										CanUserSort="True"
										SortMemberPath="Value.ArchiveVersion">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock VerticalAlignment="Center"
									   HorizontalAlignment="Center"
									   Classes.Blue="{Binding Value.IsOG}"
									   Classes.Purple="{Binding Value.IsNG}"
									   Text="{Binding Value.ArchiveVersion, StringFormat='v{0}'}">
							</TextBlock>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn Header="Format"
										Width="Auto"
										CanUserSort="True"
										SortMemberPath="Value.ArchiveFormat">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock VerticalAlignment="Center"
									   HorizontalAlignment="Center"
									   Classes.Blue="{Binding Value.IsGNRL}"
									   Classes.Purple="{Binding Value.IsDX10}"
									   Text="{Binding Value.ArchiveFormat}">
							</TextBlock>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTextColumn Header="Archive"
									Width="*"
									Binding="{Binding Value.Name}" />

				<DataGridTextColumn Header="Mod"
									Width="Auto"
									Binding="{Binding Value.Mod, TargetNullValue='Unmanaged'}" />
			</DataGrid.Columns>
		</DataGrid>

	</StackPanel>
</Window>

