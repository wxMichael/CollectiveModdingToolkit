<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:m="using:CollectiveModdingToolkit.Models"
		xmlns:v="using:CollectiveModdingToolkit.Views"
		xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
		xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
		mc:Ignorable="d"
		d:DesignWidth="760"
		d:DesignHeight="450"
		x:Class="CollectiveModdingToolkit.Views.ArchivePatcher"
		x:DataType="vm:MainWindowViewModel"
		x:CompileBindings="True"
		Title="Archive Patcher"
		Icon="/Assets/Images/icon-cm-64.png"
		Width="760"
		Height="450"
		MinWidth="760"
		MinHeight="450"
		WindowStartupLocation="CenterOwner">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<StackPanel Orientation="Vertical">
		<Grid RowDefinitions="Auto"
			  ColumnDefinitions="Auto,*,Auto"
			  Margin="10,0,10,0">
			<ctrl:GroupBox Grid.Row="0"
						   Grid.Column="0"
						   Header="Desired Version">

				<StackPanel Orientation="Horizontal">

					<RadioButton GroupName="DesiredVersion"
								 Content="v1 (OG)"
								 Margin="5,0,0,0" />

					<!--<RadioButton GroupName="DesiredVersion"
								 Content="v7 (NG)"
								 Margin="5,0,0,0" />-->

					<RadioButton GroupName="DesiredVersion"
								 Content="v8 (NG)"
								 Margin="5,0,0,0" />
				</StackPanel>
			</ctrl:GroupBox>

			<TextBlock Grid.Row="0"
					   Grid.Column="1"
					   TextAlignment="Center"
					   VerticalAlignment="Center"
					   HorizontalAlignment="Center"
					   Text="{Binding WindowTitle, Mode=OneWay}" />

			<StackPanel Grid.Row="0"
						Grid.Column="2"
						Orientation="Horizontal"
						HorizontalAlignment="Right"
						Spacing="10">

				<Button Content="About"
						MinWidth="90" />

				<Button Content="Patch All"
						Theme="{DynamicResource SolidButton}"
						Classes="Success"
						MinWidth="90" />

			</StackPanel>
		</Grid>
		<DockPanel Margin="0,5">
			<Label DockPanel.Dock="Left"
				   Content="Name Filter:"
				   VerticalAlignment="Center"
				   Margin="5,0,0,0" />

			<TextBox DockPanel.Dock="Left"
					 Margin="5,0,5,0" />
		</DockPanel>

		<ListBox x:Name="archivePatcherList"
				 ItemsSource="{Binding ModManager.ArchivesWinning}"
				 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

			<!--<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>-->

			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Key}"
							   Classes="Readable"
							   Margin="0"
							   Padding="0" />
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>

	</StackPanel>
</Window>

