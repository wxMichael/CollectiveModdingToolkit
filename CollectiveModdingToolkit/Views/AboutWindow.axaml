<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:m="using:CollectiveModdingToolkit.Models"
		xmlns:v="using:CollectiveModdingToolkit.Views"
		xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
		xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
		mc:Ignorable="d"
		d:DesignWidth="400"
		d:DesignHeight="300"
		x:Class="CollectiveModdingToolkit.Views.AboutWindow"
		x:DataType="vm:MainWindowViewModel"
		x:CompileBindings="True"
		Title="About"
		Icon="/Assets/Images/icon-cm-64.png"
		Width="400"
		Height="300"
		MinWidth="400"
		MinHeight="300"
		WindowStartupLocation="CenterOwner">

	<DockPanel Margin="10,10,10,5">

		<TextBlock DockPanel.Dock="Bottom"
				   Margin="0,5,0,0"
				   Classes="Readable Smallest"
				   HorizontalAlignment="Center">
			<Italic>Escape will also close windows.</Italic>
		</TextBlock>

		<Button DockPanel.Dock="Bottom"
				HorizontalAlignment="Stretch"
				Content="Close"
				Click="Button_Click_Close" />

		<TextBlock DockPanel.Dock="Bottom"
				   x:Name="AboutText"
				   Classes="Readable"
				   TextWrapping="WrapWithOverflow"
				   Text="&lt;About Text&gt;" />
	</DockPanel>
</Window>
