<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
             xmlns:b="using:CollectiveModdingToolkit.Behaviors"
             xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
             xmlns:conv="using:CollectiveModdingToolkit.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="500"
             x:Class="CollectiveModdingToolkit.Views.TabArchives"
             x:DataType="vm:ArchivesViewModel">

	<Design.DataContext>
		<vm:ArchivesViewModel />
	</Design.DataContext>

	<UserControl.Resources>
		<conv:PatchFailConverter x:Key="PatchFailConverter" />
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="DataGridCell TextBlock">
			<Setter Property="FontFamily"
			        Value="{StaticResource Readable}" />
			<Setter Property="FontSize"
			        Value="{StaticResource Small}" />
		</Style>

		<Style Selector="DataGridCell.Success">
			<Setter Property="Background"
			        Value="#003D00" />
		</Style>
		<Style Selector="DataGridCell.Failed">
			<Setter Property="Background"
			        Value="#3D0000" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,*"
	      ColumnDefinitions="*">

		<Grid Grid.Row="0"
		      Grid.Column="0"
		      RowDefinitions="Auto"
		      ColumnDefinitions="Auto,*,Auto">

			<!-- Desired Version -->
			<ctrl:GroupBox Grid.Row="0"
			               Grid.Column="0"
			               Header="Desired Version">

				<StackPanel Orientation="Horizontal"
				            IsEnabled="{Binding IsNotProcessing}">

					<RadioButton x:Name="DesiredVersionV1"
					             GroupName="DesiredVersion"
					             Content="v1 (OG)"
					             Margin="5,0,0,0"
					             IsChecked="{Binding IsDesiredV1}" />

					<!--<RadioButton x:Name="DesiredVersion_v7"
								 GroupName="DesiredVersion"
								 Content="v7 (NG)"
								 Margin="5,0,0,0"
								 IsChecked="False"
								 Command="{Binding SetDesiredVersionCommand}">
						<RadioButton.CommandParameter>
							<sys:Byte>7</sys:Byte>
						</RadioButton.CommandParameter>-->

					<RadioButton x:Name="DesiredVersionV8"
					             GroupName="DesiredVersion"
					             Content="v8 (NG)"
					             Margin="5,0,0,0"
					             IsChecked="{Binding IsDesiredV8}" />
				</StackPanel>
			</ctrl:GroupBox>

			<!-- Filter -->
			<TextBox Grid.Row="0"
			         Grid.Column="1"
			         Margin="5,10,0,0"
			         PlaceholderText="Filter"
			         VerticalAlignment="Center"
			         x:Name="FilterBox"
			         Text="{Binding ArchiveFilter, Mode=TwoWay}" />

			<!-- Buttons -->
			<StackPanel Grid.Row="0"
			            Grid.Column="2"
			            Orientation="Horizontal"
			            HorizontalAlignment="Right"
			            Margin="5,10,5,0"
			            Spacing="10">

				<Button Content="About"
				        MinWidth="90"
				        Margin="0"
				        Command="{Binding ShowAboutCommand}" />

				<Button Content="Patch All"
				        Classes="Primary"
				        Margin="0"
				        MinWidth="90"
				        Command="{Binding PatchArchivesCommand}" />

			</StackPanel>
		</Grid>

		<!-- Result of the last Patch All -->
		<StackPanel Grid.Row="1"
		            Orientation="Horizontal"
		            Margin="5,5,5,0"
		            Spacing="10"
		            IsVisible="{Binding PatchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<TextBlock VerticalAlignment="Center"
			           Text="{Binding PatchSummary}" />
			<Button Classes="Link"
			        Content="Show failures"
			        VerticalAlignment="Center"
			        IsVisible="{Binding HasPatchFailures}"
			        Command="{Binding ShowPatchFailuresCommand}" />
		</StackPanel>

		<DataGrid Grid.Row="2"
		          Grid.Column="0"
		          Margin="0,5,0,0"
		          Name="ArchiveList"
		          x:Name="ArchiveList"
		          ItemsSource="{Binding DisplayedArchives}"
		          DockPanel.Dock="Right"
		          RowHeight="24"
		          AutoGenerateColumns="False"
		          IsReadOnly="True"
		          GridLinesVisibility="All"
		          BorderThickness="1"
		          CanUserResizeColumns="True"
		          CanUserSortColumns="True"
		          BorderBrush="{DynamicResource StrokeMidBrush}"
		          SelectionMode="Single"
		          b:NoSelection.IsEnabled="True"
		          HorizontalScrollBarVisibility="Disabled">

			<DataGrid.Columns>

				<DataGridTemplateColumn Header="Ver."
				                        Width="Auto"
				                        CanUserSort="True"
				                        SortMemberPath="ArchiveVersion">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<DataGridCell Classes.Success="{Binding PatchSuccessful, TargetNullValue={x:False}}"
							              Classes.Failed="{Binding PatchFailed}"
							              ToolTip.ServiceEnabled="{Binding PatchFailReason}"
							              ToolTip.Tip="{Binding PatchFailReason, Converter={StaticResource PatchFailConverter}}">
								<TextBlock VerticalAlignment="Center"
								           HorizontalAlignment="Center"
								           Classes.Blue="{Binding IsOG}"
								           Classes.Purple="{Binding IsNG}"
								           Text="{Binding ArchiveVersion, StringFormat='v{0}'}" />
							</DataGridCell>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn Header="Format"
				                        Width="Auto"
				                        CanUserSort="True"
				                        SortMemberPath="ArchiveFormat">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock VerticalAlignment="Center"
							           HorizontalAlignment="Center"
							           Classes.Blue="{Binding IsGNRL}"
							           Classes.Purple="{Binding IsDX10}"
							           Text="{Binding ArchiveFormat}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTextColumn Header="Archive"
				                    Width="*"
				                    Binding="{Binding Name}" />


				<DataGridTemplateColumn Header="Source"
				                        Width="Auto"
				                        CanUserSort="True"
				                        SortMemberPath="OriginText">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Margin="{DynamicResource DataGridCellTextBlockDefaultMargin}"
							           VerticalAlignment="Center"
							           TextWrapping="Wrap"
							           Classes.Neutral="{Binding !IsManaged}"
							           Text="{Binding OriginText}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn Header=""
				                        MinWidth="44"
				                        CanUserResize="False"
				                        Width="Auto"
				                        CanUserSort="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="&#x1F4C2;"
							        MinWidth="32"
							        HorizontalAlignment="Center"
							        HorizontalContentAlignment="Center"
							        Padding="6,0"
							        Margin="2"
							        VerticalAlignment="Center"
							        ToolTip.Tip="Show in Explorer"
							        Command="{Binding $parent[DataGrid].((vm:ArchivesViewModel)DataContext).RevealFileCommand, FallbackValue={x:Null}}"
							        CommandParameter="{Binding}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

			</DataGrid.Columns>
		</DataGrid>

	</Grid>
</UserControl>
