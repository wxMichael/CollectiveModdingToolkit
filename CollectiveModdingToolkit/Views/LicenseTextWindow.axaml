<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="600"
        x:Class="CollectiveModdingToolkit.Views.LicenseTextWindow"
        Title="License"
        Icon="/Assets/Images/icon-cm-64.png"
        Width="800"
        Height="600"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterOwner">

	<DockPanel Margin="10,10,10,5">
		<TextBlock DockPanel.Dock="Bottom"
		           Margin="0,5,0,0"
		           Classes="Readable Smallest"
		           HorizontalAlignment="Center">
			<Italic>Escape will also close windows.</Italic>
		</TextBlock>

		<Button DockPanel.Dock="Bottom"
		        HorizontalAlignment="Stretch"
		        Content="Close"
		        Click="Button_Click_Close" />

		<SelectableTextBlock DockPanel.Dock="Top"
		                     x:Name="DetailsText"
		                     Classes="Readable"
		                     Margin="0,0,0,8"
		                     TextWrapping="Wrap"
		                     IsVisible="False" />

		<Border Margin="0,0,0,8"
		        BorderThickness="{DynamicResource TextBoxBorderThickness}"
		        CornerRadius="{DynamicResource TextBoxDefaultCornerRadius}"
		        BorderBrush="{DynamicResource TextBoxDefaultBorderBrush}"
		        Background="{DynamicResource TextBoxDefaultBackground}">
			<ScrollViewer VerticalScrollBarVisibility="Auto"
			              HorizontalScrollBarVisibility="Disabled">
				<TextBlock x:Name="LicenseText"
				           Margin="6,4"
				           FontFamily="Consolas"
				           TextWrapping="Wrap" />
			</ScrollViewer>
		</Border>
	</DockPanel>
</Window>
