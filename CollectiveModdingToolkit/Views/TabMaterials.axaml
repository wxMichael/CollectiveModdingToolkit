<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
             xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="500"
             x:Class="CollectiveModdingToolkit.Views.TabMaterials"
             x:DataType="vm:MaterialsViewModel">

	<Design.DataContext>
		<vm:MaterialsViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="TextBox.Invalid">
			<Setter Property="BorderBrush"
			        Value="{DynamicResource BadBrush}" />
		</Style>
		<Style Selector="TextBlock.GroupTitle">
			<Setter Property="FontWeight"
			        Value="Bold" />
			<Setter Property="Margin"
			        Value="0,10,0,2" />
		</Style>
	</UserControl.Styles>

	<Grid ColumnDefinitions="260,Auto,*">

		<!-- The list of loose materials -->
		<DockPanel Grid.Column="0">
			<StackPanel DockPanel.Dock="Top"
			            Margin="5"
			            Spacing="5">
				<TextBox PlaceholderText="Filter"
				         Text="{Binding Filter, Mode=TwoWay}" />
				<Grid ColumnDefinitions="*,*"
				      ColumnSpacing="5">
					<Button Grid.Column="0"
					        Classes="Small"
					        HorizontalAlignment="Stretch"
					        Content="Open File..."
					        Command="{Binding OpenFileCommand}" />
					<Button Grid.Column="1"
					        Classes="Small"
					        HorizontalAlignment="Stretch"
					        Content="Refresh"
					        Command="{Binding RefreshListCommand}" />
				</Grid>
			</StackPanel>
			<TextBlock DockPanel.Dock="Bottom"
			           Classes="Readable Neutral"
			           Margin="5,3"
			           Text="{Binding ListInfo}" />
			<ListBox ItemsSource="{Binding Items}"
			         SelectedItem="{Binding SelectedItem}"
			         BorderBrush="{DynamicResource StrokeMidBrush}"
			         BorderThickness="0,1">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Padding"
						        Value="0,2" />
						<Setter Property="MinHeight"
						        Value="0" />
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:MaterialListItem">
						<StackPanel Margin="5,0"
						            ToolTip.Tip="{Binding Relative}">
							<TextBlock Classes="Readable"
							           Text="{Binding Name}"
							           TextTrimming="CharacterEllipsis" />
							<TextBlock Classes="Readable Smaller Neutral"
							           Text="{Binding Mod}"
							           IsVisible="{Binding Mod, Converter={x:Static ObjectConverters.IsNotNull}}"
							           TextTrimming="CharacterEllipsis" />
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>

		<GridSplitter Grid.Column="1"
		              Width="3"
		              ResizeDirection="Columns" />

		<!-- The editor -->
		<Grid Grid.Column="2"
		      RowDefinitions="Auto,Auto,*,Auto">

			<TextBlock Grid.Row="0"
			           Grid.RowSpan="3"
			           Classes="Readable Neutral"
			           HorizontalAlignment="Center"
			           VerticalAlignment="Center"
			           TextAlignment="Center"
			           Text="Select a material, or open a BGSM / BGEM file to edit it."
			           IsVisible="{Binding !HasDocument}" />

			<!-- File, version, and actions -->
			<StackPanel Grid.Row="0"
			            Margin="8,5"
			            Spacing="5"
			            IsVisible="{Binding HasDocument}">
				<StackPanel Orientation="Horizontal"
				            Spacing="5">
					<Button Classes="Small Primary"
					        Content="Save"
					        Command="{Binding SaveCommand}" />
					<Button Classes="Small"
					        Content="Save As..."
					        Command="{Binding SaveAsCommand}" />
					<Button Classes="Small"
					        Content="Save to Overwrite"
					        IsVisible="{Binding HasOverwrite}"
					        Command="{Binding SaveToOverwriteCommand}"
					        ToolTip.Tip="Saves a copy to MO2's Overwrite folder, keeping its path below Data." />
					<Button Classes="Small"
					        Content="Revert"
					        Command="{Binding RevertCommand}" />
					<Button Classes="Small"
					        Content="&#x1F4C2; Open Path"
					        Command="{Binding RevealCommand}" />
					<TextBlock Classes="Readable Warning"
					           VerticalAlignment="Center"
					           Text="● Unsaved changes"
					           IsVisible="{Binding Document.IsDirty, FallbackValue=False}" />
				</StackPanel>
				<TextBlock Classes="Readable"
				           FontWeight="Bold"
				           Text="{Binding Document.FileName}" />
				<StackPanel Orientation="Horizontal"
				            Spacing="5">
					<StackPanel Orientation="Horizontal"
					            Background="#101010"
					            Spacing="0">
						<RadioButton Content="General"
						             Theme="{DynamicResource ButtonRadioButton}"
						             GroupName="MaterialGrouping"
						             IsChecked="{Binding GroupByGeneral, Mode=TwoWay}"
						             ToolTip.Tip="Affects both BGSM and BGEM files." />
						<RadioButton Content="{Binding Document.SpecificLabel}"
						             Theme="{DynamicResource ButtonRadioButton}"
						             GroupName="MaterialGrouping"
						             IsChecked="{Binding GroupBySpecific, Mode=TwoWay}"
						             ToolTip.Tip="{Binding Document.SpecificToolTip}" />
					</StackPanel>
					<TextBlock Classes="Readable Neutral"
					           VerticalAlignment="Center"
					           Text="{Binding Document.Description}" />
					<TextBlock Classes="Readable"
					           VerticalAlignment="Center"
					           Text="Version:" />
					<ComboBox Classes="Small"
					          MinWidth="70"
					          ItemsSource="{x:Static vm:MaterialDocument.VersionOptions}"
					          SelectedItem="{Binding Document.Version, Mode=TwoWay}"
					          ToolTip.Tip="The file format version. 1-2 are Fallout 4; 3+ are Fallout 76." />
					<Button Classes="Small"
					        Content="Convert to Fallout 4"
					        IsVisible="{Binding CanConvert}"
					        Command="{Binding ConvertToFallout4Command}" />
				</StackPanel>
			</StackPanel>

			<Separator Grid.Row="1"
			           IsVisible="{Binding HasDocument}" />

			<!-- Every value, in sections -->
			<ScrollViewer Grid.Row="2"
			              VerticalScrollBarVisibility="Auto"
			              IsVisible="{Binding HasDocument}">
				<ItemsControl ItemsSource="{Binding Document.Groups}"
				              Margin="8,0,12,8">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:MaterialGroupViewModel">
							<ctrl:GroupBox Header="{Binding Name}">
								<StackPanel>
									<ItemsControl ItemsSource="{Binding Fields}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:MaterialFieldViewModel">
												<Grid ColumnDefinitions="200,*"
												      Margin="0,1">
													<TextBlock Grid.Column="0"
													           Classes="Readable"
													           VerticalAlignment="Center"
													           Text="{Binding Label}"
													           ToolTip.Tip="{Binding JsonKey}" />

													<CheckBox Grid.Column="1"
													          MinHeight="0"
													          IsChecked="{Binding BoolValue, Mode=TwoWay}"
													          IsVisible="{Binding IsBool}" />

													<TextBox Grid.Column="1"
													         Classes="Small"
													         Text="{Binding Text, Mode=TwoWay}"
													         IsVisible="{Binding IsPlainText}" />

													<Grid Grid.Column="1"
													      ColumnDefinitions="*,Auto"
													      IsVisible="{Binding HasPicker}">
														<TextBox Grid.Column="0"
														         Classes="Small"
														         PlaceholderText="{Binding PickerPlaceholder}"
														         Text="{Binding Text, Mode=TwoWay}" />
														<Button Grid.Column="1"
														        Classes="Small"
														        Margin="6,0,0,0"
														        Content="&#x2026;"
														        Command="{Binding PickFileCommand}"
														        ToolTip.Tip="Choose a file" />
													</Grid>

													<NumericUpDown Grid.Column="1"
													               Classes="Small"
													               HorizontalAlignment="Left"
													               MinWidth="160"
													               Minimum="0"
													               Maximum="{Binding NumberMaximum}"
													               Increment="{Binding NumberIncrement}"
													               FormatString="{Binding NumberFormat}"
													               Value="{Binding Number, Mode=TwoWay}"
													               IsVisible="{Binding IsNumber}" />

													<ComboBox Grid.Column="1"
													          Classes="Small"
													          HorizontalAlignment="Left"
													          MinWidth="160"
													          ItemsSource="{Binding Options}"
													          SelectedItem="{Binding Text, Mode=TwoWay}"
													          IsVisible="{Binding IsEnum}" />

													<StackPanel Grid.Column="1"
													            Orientation="Horizontal"
													            Spacing="6"
													            IsVisible="{Binding IsColor}">
														<Button Width="28"
														        Height="28"
														        Padding="0"
														        ToolTip.Tip="Pick a color">
															<Border Width="20"
															        Height="20"
															        CornerRadius="3"
															        BorderThickness="1"
															        BorderBrush="{DynamicResource StrokeBrightBrush}"
															        Background="{Binding Swatch}" />
															<Button.Flyout>
																<Flyout Placement="BottomEdgeAlignedLeft">
																	<ColorView Color="{Binding PickerColor, Mode=TwoWay}"
																	           IsAlphaEnabled="False"
																	           IsColorPaletteVisible="False" />
																</Flyout>
															</Button.Flyout>
														</Button>
														<TextBox Width="100"
														         Classes.Invalid="{Binding IsInvalid}"
														         Text="{Binding Text, Mode=TwoWay}" />
													</StackPanel>
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</ctrl:GroupBox>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<TextBlock Grid.Row="3"
			           Classes="Readable"
			           Margin="8,3"
			           ctrl:Status.Level="{Binding StatusLevel}"
			           Text="{Binding StatusText}"
			           TextWrapping="Wrap" />
		</Grid>
	</Grid>
</UserControl>
