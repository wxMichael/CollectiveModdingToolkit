<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="500"
             x:Class="CollectiveModdingToolkit.Views.TabUpdate"
             x:DataType="vm:UpdateViewModel">

	<Design.DataContext>
		<vm:UpdateViewModel />
	</Design.DataContext>

	<StackPanel HorizontalAlignment="Center"
	            VerticalAlignment="Center"
	            Spacing="10">
		<TextBlock HorizontalAlignment="Center"
		           Text="A new version of Collective Modding Toolkit is available" />
		<Button Classes="Link"
		        HorizontalAlignment="Center"
		        FontSize="{StaticResource FontSizeBase}"
		        Content="{Binding LinkText}"
		        Command="{Binding OpenNexusPageCommand}"
		        ToolTip.Tip="https://www.nexusmods.com/site/mods/1597" />
	</StackPanel>
</UserControl>
