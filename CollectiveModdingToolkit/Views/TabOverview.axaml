<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:m="CollectiveModdingToolkit.Models"
			 xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
			 xmlns:tips="clr-namespace:CollectiveModdingToolkit.Models.Tooltips"
			 xmlns:conv="using:CollectiveModdingToolkit.Converters"
			 xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
			 mc:Ignorable="d"
			 d:DesignWidth="800"
			 d:DesignHeight="500"
			 x:Class="CollectiveModdingToolkit.Views.TabOverview"
			 x:DataType="vm:MainWindowViewModel">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<UserControl.Resources>
		<conv:RemoveFileExtConverter x:Key="RemoveFileExtConverter" />
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="ctrl|GroupBox > StackPanel > Grid">
			<Setter Property="ToolTip.Placement"
					Value="LeftEdgeAlignedTop" />
			<Setter Property="ToolTip.HorizontalOffset"
					Value="-10" />
			<Setter Property="ToolTip.VerticalOffset"
					Value="0" />
		</Style>

		<!-- Overview Tables -->
		<Style Selector="Grid#OverviewTopPanel">
			<Setter Property="Margin"
					Value="5,0,5,5" />

			<!-- Color all text except first column -->
			<Style Selector="^ TextBlock">
				<Setter Property="Foreground"
						Value="{StaticResource Neutral2}" />
			</Style>
			<Style Selector="^ > TextBlock[(Grid.Column)=0]">
				<Setter Property="Foreground"
						Value="{StaticResource DefaultFG}" />
			</Style>
		</Style>

		<Style Selector="Grid.Table > TextBlock">
			<Style Selector="^[(Grid.Column)=0]">
				<Setter Property="TextAlignment"
						Value="Right" />
				<Setter Property="Margin"
						Value="0, 0, 5, 0" />
			</Style>
			<Style Selector="^[(Grid.Column)=1]">
				<Setter Property="Foreground"
						Value="{StaticResource Neutral2}" />
				<Setter Property="Margin"
						Value="0" />
			</Style>
			<Style Selector="^[(Grid.Column)=2]">
				<Setter Property="Foreground"
						Value="{StaticResource Neutral2}" />
				<Setter Property="Margin"
						Value="0" />
			</Style>
		</Style>



	</UserControl.Styles>

	<!-- Overview Top Panel -->
	<Grid ColumnDefinitions="1.1*,*,*"
		  RowDefinitions="Auto,*,*">

		<Grid Name="OverviewTopPanel"
			  Classes="Table"
			  Grid.Row="0"
			  Grid.Column="0"
			  Grid.ColumnSpan="3"
			  RowDefinitions="Auto,Auto,Auto,Auto"
			  ColumnDefinitions="Auto,*,Auto">

			<!-- Mod Manager -->
			<TextBlock Grid.Row="0"
					   Grid.Column="0"
					   Text="Mod Manager:" />

			<TextBlock Grid.Row="0"
					   Grid.Column="1">
				<Run Text="{Binding ModManager.AppName, Mode=OneWay}"
					 Classes.Bad="{Binding ModManager.AppPath, Converter={x:Static StringConverters.IsNullOrEmpty}}}" />
				<Run Text="{Binding ModManager.AppVersionString, StringFormat='v{0}', TargetNullValue=''}" />
				<Run Text="{Binding ModManager.Profile, Mode=OneWay, StringFormat='[Profile: {0}]', TargetNullValue=''}" />
				<!--TargetNullValue='[Profile: Unknown]'}" />-->
			</TextBlock>

			<!-- Game Path -->
			<TextBlock Grid.Row="1"
					   Grid.Column="0"
					   Text="Game Path:" />

			<TextBlock Grid.Row="1"
					   Grid.Column="1"
					   Text="{Binding Game.GamePath}"
					   ToolTip.Tip="Click to open folder"
					   Cursor="Hand"
					   PointerReleased="GamePath_PointerReleased"/>

			<!-- Version -->
			<TextBlock Grid.Row="2"
					   Grid.Column="0"
					   Text="Version:" />

			<TextBlock Grid.Row="2"
					   Grid.Column="1"
					   Text="{Binding Game.GameVersion}"
					   Classes="Good" />

			<!-- PC Specs -->
			<TextBlock Grid.Row="3"
					   Grid.Column="0"
					   Text="PC Specs:" />

			<Grid Grid.Row="3"
				  Grid.Column="1"
				  RowDefinitions="Auto,Auto"
				  ColumnDefinitions="*,*">

				<TextBlock Grid.Row="0"
						   Grid.Column="0">
					<Run Text="{Binding Computer.Os}" />
					<Run Text="{Binding Computer.Bits, StringFormat='{}{0}-bit'}" />
				</TextBlock>

				<TextBlock Grid.Row="1"
						   Grid.Column="0"
						   Text="{Binding Computer.Ram, StringFormat='{}{0} GB RAM', Mode=OneWay}" />

				<TextBlock Grid.Row="0"
						   Grid.Column="1"
						   Text="{Binding Computer.Cpu}" />

				<TextBlock Grid.Row="1"
						   Grid.Column="1">
					<Run Text="{Binding Computer.Gpu}" />
					<Run Text="{Binding Computer.Vram, StringFormat='{}{0} GB', Mode=OneWay}" />
				</TextBlock>
			</Grid>

			<!-- Refresh -->
			<Button Name="RefreshButton"
					Grid.Row="0"
					Grid.Column="2"
					Grid.RowSpan="2"
					Command="{Binding RefreshCommand}"
					Content="Refresh" />
		</Grid>

		<!-- Game Binaries -->
		<ctrl:GroupBox Grid.Row="1"
					   Grid.Column="0"
					   Header="Game (EXE/DLL)">

			<DataGrid DockPanel.Dock="Top"
					  Name="GameBinariesList"
					  ItemsSource="{Binding Game.Binaries}"
					  AutoGenerateColumns="False"
					  IsReadOnly="True"
					  CanUserResizeColumns="False"
					  CanUserSortColumns="False"
					  HeadersVisibility="None"
					  SelectionMode="Single"
					  SelectionChanged="DataGrid_SelectionChanged"
					  HorizontalScrollBarVisibility="Disabled"
					  VerticalScrollBarVisibility="Disabled">

				<DataGrid.Columns>
					<DataGridTemplateColumn Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<DataGridCell PointerPressed="BinariesList_PointerPressed"
											  PointerEntered="BinariesList_PointerEntered"
											  PointerExited="BinariesList_PointerExited">
									<TextBlock Text="{Binding Name, StringFormat='{}{0}:', Converter={StaticResource RemoveFileExtConverter}}"
											   VerticalAlignment="Center"
											   HorizontalAlignment="Right"
											   Classes="Small" />
								</DataGridCell>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn Width="Auto">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<DataGridCell MinWidth="95"
											  PointerPressed="BinariesList_PointerPressed"
											  PointerEntered="BinariesList_PointerEntered"
											  PointerExited="BinariesList_PointerExited">

									<TextBlock Text="{Binding DisplayText}"
											   VerticalAlignment="Center"
											   HorizontalAlignment="Left"
											   Margin="5,0,0,0"
											   Classes="Small"
											   Classes.Good="{Binding IsGood}"
											   Classes.Bad="{Binding !IsGood}" />
								</DataGridCell>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</ctrl:GroupBox>

		<!-- Creation Kit Binaries -->
		<ctrl:GroupBox Grid.Row="2"
					   Grid.Column="0"
					   Header="Creation Kit (EXE/DLL)">

			<DataGrid DockPanel.Dock="Top"
					  Name="CKBinariesList"
					  ItemsSource="{Binding CKBinaries}"
					  AutoGenerateColumns="False"
					  IsReadOnly="True"
					  CanUserResizeColumns="False"
					  CanUserSortColumns="False"
					  HeadersVisibility="None"
					  SelectionMode="Single"
					  SelectionChanged="DataGrid_SelectionChanged"
					  HorizontalScrollBarVisibility="Disabled"
					  VerticalScrollBarVisibility="Disabled">

				<DataGrid.Columns>
					<DataGridTemplateColumn Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<DataGridCell>
									<TextBlock Text="{Binding Key, StringFormat='{}{0}:'}"
											   VerticalAlignment="Center"
											   HorizontalAlignment="Right"
											   Classes="Small" />
								</DataGridCell>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn Width="Auto">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<DataGridCell MinWidth="95">
									<TextBlock Text="{Binding Value}"
											   VerticalAlignment="Center"
											   HorizontalAlignment="Left"
											   Margin="5,0,0,0"
											   Classes="Small Good" />
								</DataGridCell>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>

		</ctrl:GroupBox>

		<!-- Archives -->
		<ctrl:GroupBox Grid.Row="1"
					   Grid.Column="1"
					   Header="Archives (BA2)">

			<!--<DockPanel Margin="0,0,0,5">
				
				<Button DockPanel.Dock="Bottom"
						Content="Archive Patcher"
						Click="Button_Click_OpenArchivePatcher" />-->

			<StackPanel DockPanel.Dock="Top">
				<Grid Classes="Table"
					  ColumnDefinitions="Auto,Auto,*"
					  RowDefinitions="Auto,Auto,Auto,Auto">

					<ToolTip.Tip>
						<TextBlock>
							<Bold>General/GNRL/Main:</Bold> Used for all non-texture files. Hard limit of <Bold>256</Bold>, after which the game will crash at the main menu.<LineBreak />
							<LineBreak />
							<Bold>Texture/DX10:</Bold> Used only for textures. No hard limit, but functional limit is <Bold>255</Bold>, after which the game fails to use correct textures.<LineBreak />
							<LineBreak />
							<Bold>Unreadable:</Bold> Files that could not be read due to permissions, unexpected format, or corruption. These are excluded from the counts.
						</TextBlock>
					</ToolTip.Tip>

					<TextBlock Grid.Row="0"
							   Grid.Column="0"
							   Text="General:" />
					<TextBlock Grid.Row="0"
							   Grid.Column="1"
							   Text="{Binding Game.ArchivesGeneral.Count, StringFormat='{}{0,4}'}"
							   Classes="Good"
							   Classes.Warning="{Binding Game.ArchivesGeneralWarning}"
							   Classes.Bad="{Binding Game.ArchivesGeneralMaxed}" />
					<TextBlock Grid.Row="0"
							   Grid.Column="2"
							   Text="{Binding Game.MaxArchivesGeneral, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="1"
							   Grid.Column="0"
							   Text="Texture:" />
					<TextBlock Grid.Row="1"
							   Grid.Column="1"
							   Text="{Binding Game.ArchivesTexture.Count, StringFormat='{}{0,4}'}"
							   Classes="Good"
							   Classes.Warning="{Binding Game.ArchivesTextureWarning}"
							   Classes.Bad="{Binding Game.ArchivesTextureMaxed}" />
					<TextBlock Grid.Row="1"
							   Grid.Column="2"
							   Text="{Binding Game.MaxArchivesTexture, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="2"
							   Grid.Column="0"
							   Text="Total:" />
					<TextBlock Grid.Row="2"
							   Grid.Column="1"
							   Text="{Binding Game.TotalArchives, StringFormat='{}{0,4}'}"
							   Classes="Good"
							   Classes.Warning="{Binding Game.TotalArchivesWarning}"
							   Classes.Bad="{Binding Game.TotalArchivesMaxed}" />
					<TextBlock Grid.Row="2"
							   Grid.Column="2"
							   Text="{Binding Game.TotalArchivesMax, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="3"
							   Grid.Column="0"
							   Text="Unreadable:"
							   Classes="Neutral"
							   Classes.Bad="{Binding Game.HasArchivesUnreadable}" />
					<TextBlock Grid.Row="3"
							   Grid.Column="1"
							   Text="{Binding Game.ArchivesUnreadable.Count, StringFormat='{}{0,4}'}"
							   Classes="Neutral"
							   Classes.Bad="{Binding Game.HasArchivesUnreadable}" />
				</Grid>
				<Grid Classes="Table"
					  ColumnDefinitions="Auto,Auto,*"
					  RowDefinitions="Auto,Auto,Auto,Auto">

					<ToolTip.Tip>
						<TextBlock>
							<Bold>v1:</Bold> Works with all FO4 versions.<LineBreak />
							<LineBreak />
							<Bold>v7/v8:</Bold> Require either <Bold>BASS</Bold> or <Bold>NG</Bold>.<LineBreak />
							Some apps only support <Bold>v1</Bold>.<LineBreak />
							<LineBreak />
							<Bold>v????:</Bold> These modules have an unsupported archive version.<LineBreak />
							Fallout 4 supports only <Bold>v1</Bold>, <Bold>v7</Bold>, and <Bold>v8</Bold>.<LineBreak />
							<LineBreak />
							Files with other versions were likey made for other games and should be repacked for Fallout 4.
						</TextBlock>
					</ToolTip.Tip>

					<Separator Grid.Row="0"
							   Grid.Column="0"
							   Grid.ColumnSpan="3" />

					<TextBlock Grid.Row="1"
							   Grid.Column="0"
							   Text="(OG) v1   :" />
					<TextBlock Grid.Row="1"
							   Grid.Column="1"
							   Text="{Binding Game.ArchivesOG.Count, StringFormat='{}{0,4}'}" />

					<TextBlock Grid.Row="2"
							   Grid.Column="0"
							   Text="(NG) v7/8 :" />
					<TextBlock Grid.Row="2"
							   Grid.Column="1"
							   Text="{Binding Game.ArchivesNG.Count, StringFormat='{}{0,4}'}" />

					<TextBlock Grid.Row="3"
							   Grid.Column="0"
							   Text="v????:"
							   Classes="Neutral"
							   Classes.Bad="{Binding Game.HasArchivesUnknown}" />
					<TextBlock Grid.Row="3"
							   Grid.Column="1"
							   Text="{Binding Game.ArchivesUnknown.Count, StringFormat='{}{0,4}'}"
							   Classes="Neutral"
							   Classes.Bad="{Binding Game.HasArchivesUnknown}" />
				</Grid>
			</StackPanel>
			<!--</DockPanel>-->
		</ctrl:GroupBox>

		<!-- Modules -->
		<ctrl:GroupBox Grid.Row="2"
					   Grid.Column="1"
					   Header="Modules (ESM/ESL/ESP)">

			<StackPanel>
				<Grid Classes="Table"
					  ColumnDefinitions="Auto,Auto,*"
					  RowDefinitions="Auto,Auto,Auto,Auto">

					<ToolTip.Tip>
						<TextBlock>
							<Bold>Full modules</Bold> include all non-<Bold>Light</Bold> modules.<LineBreak />
							<Bold>Light modules</Bold> are <Bold>ESL-flagged</Bold> and/or have the <Bold>.esl</Bold> extension.<LineBreak />
							<LineBreak />
							Light modules give up the capacity to contain more than <Bold>4095</Bold> new records in exchange for having a higher plugin limit.<LineBreak />
							<LineBreak />
							<Bold>Unreadable:</Bold> Files that could not be read due to permissions, unexpected format, or corruption. These are excluded from the counts.
						</TextBlock>
					</ToolTip.Tip>

					<TextBlock Grid.Row="0"
							   Grid.Column="0"
							   Text="Full:" />
					<TextBlock Grid.Row="0"
							   Grid.Column="1"
							   Text="{Binding Game.ModulesFull.Count, StringFormat='{}{0,5}'}"
							   Classes="Good"
							   Classes.Warning="{Binding Game.ModulesFullWarning}"
							   Classes.Bad="{Binding Game.ModulesFullMaxed}" />
					<TextBlock Grid.Row="0"
							   Grid.Column="2"
							   Text="{Binding Game.MaxModulesFull, StringFormat=' /  {0}'}" />

					<TextBlock Grid.Row="1"
							   Grid.Column="0"
							   Text="Light:" />
					<TextBlock Grid.Row="1"
							   Grid.Column="1"
							   Text="{Binding Game.ModulesLight.Count, StringFormat='{}{0,5}'}"
							   Classes="Good"
							   Classes.Warning="{Binding Game.ModulesLightWarning}"
							   Classes.Bad="{Binding Game.ModulesLightMaxed}" />
					<TextBlock Grid.Row="1"
							   Grid.Column="2"
							   Text="{Binding Game.MaxModulesLight, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="2"
							   Grid.Column="0"
							   Text="Total:" />
					<TextBlock Grid.Row="2"
							   Grid.Column="1"
							   Text="{Binding Game.TotalModules, StringFormat='{}{0,5}'}"
							   Classes="Good"
							   Classes.Warning="{Binding Game.TotalModulesWarning}"
							   Classes.Bad="{Binding Game.TotalModulesMaxed}" />
					<TextBlock Grid.Row="2"
							   Grid.Column="2"
							   Text="{Binding Game.TotalModulesMax, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="3"
							   Grid.Column="0"
							   Text="Unreadable:"
							   Classes="Neutral"
							   Classes.Bad="{Binding Game.HasModulesUnreadable}" />
					<TextBlock Grid.Row="3"
							   Grid.Column="1"
							   Text="{Binding Game.ModulesUnreadable.Count, StringFormat='{}{0,5}'}"
							   Classes="Neutral"
							   Classes.Bad="{Binding Game.HasModulesUnreadable}" />
				</Grid>
				<Grid Classes="Table"
					  ColumnDefinitions="Auto,Auto,*"
					  RowDefinitions="Auto,Auto,Auto,Auto">

					<ToolTip.Tip>
						<TextBlock>
							<Bold>Plugin header v1.00</Bold> has a larger Form ID range than <Bold>v0.95</Bold>.<LineBreak />
							Any plugins with IDs below <Bold>800</Bold> <Bold Classes="Caution">MUST</Bold> be <Bold>v1.00</Bold>.<LineBreak />
							<LineBreak />
							FO4VR only supports <Bold>v0.95</Bold>.<LineBreak />
							<LineBreak />
							In the base game, these 4 modules are <Bold>v0.95</Bold>:<LineBreak />
							• DLCCoast.esm<LineBreak />
							• DLCworkshop02.esm<LineBreak />
							• DLCworkshop03.esm<LineBreak />
							• DLCNukaWorld.esm<LineBreak />
							<LineBreak />
							<Bold>HEDR v????:</Bold> These modules have an unsupported header version.<LineBreak />
							Fallout 4 supports only <Bold>v0.95</Bold> and <Bold>v1.00</Bold>.<LineBreak />
							<LineBreak />
							Files with <Bold Classes="Bad">v0.94</Bold> were likey made with <Bold Classes="Bad">FalloutSnip</Bold> and should be replaced, recreated, or removed.<LineBreak />
							Use such mods <Bold Classes="Bad">AT YOUR OWN RISK</Bold> as they may result in unknown behavior or issues due to having an invalid structure or corruption.
						</TextBlock>
					</ToolTip.Tip>

					<Separator Grid.Row="0"
							   Grid.Column="0"
							   Grid.ColumnSpan="3" />

					<TextBlock Grid.Row="1"
							   Grid.Column="0"
							   Text="HEDR v1.00:" />
					<TextBlock Grid.Row="1"
							   Grid.Column="1"
							   Text="{Binding Game.Modules100.Count, StringFormat='{}{0,5}'}" />

					<TextBlock Grid.Row="2"
							   Grid.Column="0"
							   Text="HEDR v0.95:" />
					<TextBlock Grid.Row="2"
							   Grid.Column="1"
							   Text="{Binding Game.Modules095.Count, StringFormat='{}{0,5}'}" />

					<TextBlock Grid.Row="3"
							   Grid.Column="0"
							   Text="HEDR v????:"
							   Classes="Neutral"
							   Classes.Bad="{Binding Game.HasModulesUnknown}" />
					<TextBlock Grid.Row="3"
							   Grid.Column="1"
							   Text="{Binding Game.ModulesUnknown.Count, StringFormat='{}{0,5}'}"
							   Classes="Neutral"
							   Classes.Bad="{Binding Game.HasModulesUnknown}" />
				</Grid>
			</StackPanel>
		</ctrl:GroupBox>

		<!-- F4SE -->
		<ctrl:GroupBox Grid.Row="1"
					   Grid.Column="2"
					   Header="F4SE">

			<StackPanel Orientation="Vertical"
						Margin="5"
						Spacing="5">

				<UniformGrid Rows="1"
							 Columns="3">

					<TextBlock Grid.Column="0"
							   TextAlignment="Center"
							   Classes="Good">
						<Span Classes="Emoji">✔</Span> 20
					</TextBlock>

					<TextBlock Grid.Column="1"
							   TextAlignment="Center"
							   Classes="Bad">
						<Span Classes="Emoji">❌</Span> 3
					</TextBlock>

					<TextBlock Grid.Column="2"
							   TextAlignment="Center"
							   Classes="Caution">
						<Span Classes="Emoji">⚠️</Span> 2
					</TextBlock>
				</UniformGrid>

				<!-- F4SE DLLs -->
				<DataGrid DockPanel.Dock="Top"
						  Name="F4SEDLLsList"
						  ItemsSource="{Binding DLLs}"
						  AutoGenerateColumns="False"
						  IsReadOnly="True"
						  CanUserResizeColumns="False"
						  CanUserSortColumns="False"
						  HeadersVisibility="None"
						  SelectionMode="Single"
						  SelectionChanged="DataGrid_SelectionChanged"
						  HorizontalScrollBarVisibility="Disabled"
						  VerticalScrollBarVisibility="Disabled">

					<DataGrid.Columns>
						<DataGridTemplateColumn Width="*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<DataGridCell>
										<TextBlock Text="{Binding Key, StringFormat='{}{0}:'}"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Right"
												   Classes="Small" />
									</DataGridCell>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn Width="Auto">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<DataGridCell MinWidth="95">
										<TextBlock Text="{Binding Value, TargetNullValue='Not Found'}"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Left"
												   Margin="5,0,0,0"
												   Classes="Small Good"
												   Classes.Bad="{Binding Value, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
									</DataGridCell>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>

			</StackPanel>
		</ctrl:GroupBox>

		<!-- Misc -->
		<ctrl:GroupBox Grid.Row="2"
					   Grid.Column="2"
					   Header="Misc">

			<StackPanel>
				<TextBlock>
					Crash Logs Today: <Span Classes="Bad">4</Span>
					<InlineUIContainer>
						<Svg Grid.Row="0"
							 Grid.Column="1"
							 Margin="0"
							 MaxHeight="24"
							 MaxWidth="24"
							 HorizontalAlignment="Center"
							 Stretch="Uniform"
							 Path="/Assets/Images/icon-folder.svg" />
					</InlineUIContainer>
				</TextBlock>
			</StackPanel>

		</ctrl:GroupBox>

	</Grid>
</UserControl>
