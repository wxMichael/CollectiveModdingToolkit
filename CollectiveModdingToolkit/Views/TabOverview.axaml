<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
             xmlns:b="using:CollectiveModdingToolkit.Behaviors"
             xmlns:conv="using:CollectiveModdingToolkit.Converters"
             xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
             xmlns:models="using:CollectiveModdingToolkit.Models"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="500"
             x:Class="CollectiveModdingToolkit.Views.TabOverview"
             x:DataType="vm:OverviewViewModel">

	<Design.DataContext>
		<vm:OverviewViewModel />
	</Design.DataContext>

	<UserControl.Resources>
		<conv:RemoveFileExtConverter x:Key="RemoveFileExtConverter" />
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Binary version cells show the game version, and the full version while hovered. -->
		<Style Selector="TextBlock.Full">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="DataGridCell:pointerover TextBlock.Full">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		<Style Selector="DataGridCell:pointerover TextBlock.Short">
			<Setter Property="IsVisible" Value="False" />
		</Style>

		<Style Selector="ctrl|GroupBox > StackPanel">
			<Setter Property="Margin"
			        Value="5" />
		</Style>

		<Style Selector="ctrl|GroupBox > StackPanel > Grid">
			<Setter Property="ToolTip.Placement"
			        Value="LeftEdgeAlignedTop" />
			<Setter Property="ToolTip.HorizontalOffset"
			        Value="-10" />
			<Setter Property="ToolTip.VerticalOffset"
			        Value="0" />
		</Style>

		<!-- Overview Tables -->
		<Style Selector="Grid#OverviewTopPanel">
			<Setter Property="Margin"
			        Value="5,0,5,5" />

			<Style Selector="^ TextBlock">
				<Setter Property="Foreground"
				        Value="{DynamicResource Neutral2Brush}" />
			</Style>

			<Style Selector="^ > TextBlock[(Grid.Column)=0]">
				<Setter Property="Foreground"
				        Value="{DynamicResource TextBrushBright}" />
			</Style>
		</Style>

		<Style Selector="Grid.Table > TextBlock">
			<Style Selector="^[(Grid.Column)=0]">
				<Setter Property="TextAlignment"
				        Value="Right" />
				<Setter Property="Margin"
				        Value="0, 0, 5, 0" />
			</Style>
			<Style Selector="^[(Grid.Column)=1]">
				<Setter Property="Margin"
				        Value="0" />
				<!-- Default color only, so status classes can override it -->
				<Style Selector="^:not(.Good):not(.Caution):not(.Warning):not(.Bad):not(.Neutral)">
					<Setter Property="Foreground"
					        Value="{DynamicResource Neutral2Brush}" />
				</Style>
			</Style>
			<Style Selector="^[(Grid.Column)=2]">
				<Setter Property="Margin"
				        Value="0" />
				<!-- Default color only, so status classes can override it -->
				<Style Selector="^:not(.Good):not(.Caution):not(.Warning):not(.Bad):not(.Neutral)">
					<Setter Property="Foreground"
					        Value="{DynamicResource Neutral2Brush}" />
				</Style>
			</Style>
		</Style>

		<Style Selector="#GameBinariesGroupBox, #CKBinariesGroupBox, #ArchivesGroupBox, #ModulesGroupBox">
			<Style Selector="^ Grid.Table TextBlock">
				<Style Selector="^[(Grid.Column)=0], ^[(Grid.Column)=1]">
					<Setter Property="TextAlignment"
					        Value="Right" />
				</Style>
				<Setter Property="FontFamily"
				        Value="{StaticResource MonoFont}" />
			</Style>
		</Style>

	</UserControl.Styles>

	<!-- Overview Top Panel -->
	<Grid ColumnDefinitions="1.1*,*,*"
	      RowDefinitions="Auto,*,*">

		<Grid Name="OverviewTopPanel"
		      Classes="Table"
		      Grid.Row="0"
		      Grid.Column="0"
		      Grid.ColumnSpan="3"
		      RowDefinitions="Auto,Auto,Auto,Auto"
		      ColumnDefinitions="Auto,*,Auto">

			<!-- Mod Manager -->
			<TextBlock Grid.Row="0"
			           Grid.Column="0"
			           Text="Mod Manager:" />

			<TextBlock Grid.Row="0"
			           Grid.Column="1">
				<Run Text="{Binding ModManager.AppName, Mode=OneWay, FallbackValue=''}"
				     Classes.Bad="{Binding ModManager.AppPath, Converter={x:Static StringConverters.IsNullOrEmpty}, FallbackValue=True}" />
				<Run
					Text="{Binding ModManager.AppVersionString, StringFormat='v{0}', TargetNullValue='', FallbackValue=''}" />
				<Run
					Text="{Binding ModManager.Profile, Mode=OneWay, StringFormat='[Profile: {0}]', TargetNullValue='', FallbackValue=''}" />
				<!--TargetNullValue='[Profile: Unknown]'}" />-->
			</TextBlock>

			<!-- Game Path -->
			<TextBlock Grid.Row="1"
			           Grid.Column="0"
			           Text="Game Path:" />

			<TextBlock Grid.Row="1"
			           Grid.Column="1"
			           Text="{Binding Game.GamePath, FallbackValue=''}"
			           ToolTip.Tip="Click to open folder"
			           Cursor="Hand"
			           PointerReleased="GamePath_PointerReleased" />

			<!-- Version -->
			<TextBlock Grid.Row="2"
			           Grid.Column="0"
			           Text="Version:" />

			<TextBlock Grid.Row="2"
			           Grid.Column="1"
			           Text="{Binding Game.GameVersion, FallbackValue=''}"
			           Classes="Good" />

			<!-- PC Specs -->
			<TextBlock Grid.Row="3"
			           Grid.Column="0"
			           Text="PC Specs:" />

			<Panel Grid.Row="3"
			       Grid.Column="1"
			       DataContext="{Binding Computer}">
				<Grid x:DataType="models:Computer"
				      RowDefinitions="Auto,Auto"
				      ColumnDefinitions="*,*">

					<TextBlock Grid.Row="0"
					           Grid.Column="0">
						<Run Text="{Binding OS}" />
						<Run Text="{Binding Bits, StringFormat='{}{0}-bit'}" />
					</TextBlock>

					<TextBlock Grid.Row="1"
					           Grid.Column="0"
					           Text="{Binding RAM, StringFormat='{}{0} GB RAM', Mode=OneWay}" />

					<TextBlock Grid.Row="0"
					           Grid.Column="1"
					           Text="{Binding CPU}" />

					<TextBlock Grid.Row="1"
					           Grid.Column="1"
					           Text="{Binding GpuText}"
					           ToolTip.Tip="{Binding GpuDetails}" />
				</Grid>
			</Panel>

			<!-- Refresh -->
			<Button Name="RefreshButton"
			        Grid.Row="0"
			        Grid.Column="2"
			        Grid.RowSpan="2"
			        Command="{Binding RefreshCommand}"
			        Content="Refresh" />
		</Grid>

		<!-- Game Binaries -->
		<ctrl:GroupBox DataContext="{Binding Game}"
		               Name="GameBinariesGroupBox"
		               Grid.Row="1"
		               Grid.Column="0"
		               Header="Game (EXE/DLL)">

			<StackPanel x:DataType="models:Game">
				<DataGrid Name="GameBinariesList"
				          ItemsSource="{Binding BinariesGame}"
				          AutoGenerateColumns="False"
				          IsReadOnly="True"
				          CanUserResizeColumns="False"
				          CanUserSortColumns="False"
				          HeadersVisibility="None"
				          GridLinesVisibility="None"
				          SelectionMode="Single"
				          b:NoSelection.IsEnabled="True"
				          HorizontalScrollBarVisibility="Disabled"
				          VerticalScrollBarVisibility="Disabled">

					<DataGrid.Columns>
						<DataGridTemplateColumn Width="*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<DataGridCell PointerPressed="BinariesList_PointerPressed">
										<TextBlock
											Text="{Binding Name, StringFormat='{}{0}:', Converter={StaticResource RemoveFileExtConverter}}"
											VerticalAlignment="Center"
											HorizontalAlignment="Right" />
									</DataGridCell>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn Width="Auto">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<DataGridCell MinWidth="95"
									              PointerPressed="BinariesList_PointerPressed">

										<Panel>
											<TextBlock Text="{Binding GameVersion}"
											           VerticalAlignment="Center"
											           HorizontalAlignment="Left"
											           Margin="5,0,0,0"
											           Classes="Short"
											           ctrl:Status.Level="{Binding Level}" />
											<TextBlock Text="{Binding FullVersion}"
											           VerticalAlignment="Center"
											           HorizontalAlignment="Left"
											           Margin="5,0,0,0"
											           Classes="Full"
											           ctrl:Status.Level="{Binding Level}" />
										</Panel>
									</DataGridCell>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>

				<Grid ColumnDefinitions="*,Auto"
				      IsVisible="{Binding AddressLibraryPath, Converter={x:Static ObjectConverters.IsNotNull}}">
					<TextBlock Grid.Column="0"
					           Text="Address Library:"
					           HorizontalAlignment="Right" />
					<TextBlock Grid.Column="1"
					           MinWidth="95"
					           Padding="5,0,0,0"
					           Text="{Binding AddressLibraryText}"
					           ctrl:Status.Level="{Binding AddressLibraryStatus}"
					           ToolTip.Tip="{Binding AddressLibraryTip}" />
				</Grid>
			</StackPanel>
		</ctrl:GroupBox>

		<!-- Creation Kit Binaries -->
		<ctrl:GroupBox DataContext="{Binding Game}"
		               Name="CKBinariesGroupBox"
		               Grid.Row="2"
		               Grid.Column="0"
		               Header="Creation Kit (EXE/DLL)">

			<DataGrid DockPanel.Dock="Top"
			          Name="CKBinariesList"
			          x:DataType="models:Game"
			          ItemsSource="{Binding BinariesCK}"
			          AutoGenerateColumns="False"
			          IsReadOnly="True"
			          CanUserResizeColumns="False"
			          CanUserSortColumns="False"
			          HeadersVisibility="None"
			          GridLinesVisibility="None"
			          SelectionMode="Single"
			          b:NoSelection.IsEnabled="True"
			          HorizontalScrollBarVisibility="Disabled"
			          VerticalScrollBarVisibility="Disabled">

				<DataGrid.Columns>
					<DataGridTemplateColumn Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<DataGridCell PointerPressed="BinariesList_PointerPressed">
									<TextBlock
										Text="{Binding Name, StringFormat='{}{0}:', Converter={StaticResource RemoveFileExtConverter}}"
										VerticalAlignment="Center"
										HorizontalAlignment="Right" />
								</DataGridCell>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn Width="Auto">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<DataGridCell MinWidth="95"
								              PointerPressed="BinariesList_PointerPressed">

									<Panel>
										<TextBlock Text="{Binding GameVersion}"
										           VerticalAlignment="Center"
										           HorizontalAlignment="Left"
										           Margin="5,0,5,0"
										           Classes="Short"
										           ctrl:Status.Level="{Binding Level}" />
										<TextBlock Text="{Binding FullVersion}"
										           VerticalAlignment="Center"
										           HorizontalAlignment="Left"
										           Margin="5,0,5,0"
										           Classes="Full"
										           ctrl:Status.Level="{Binding Level}" />
									</Panel>
								</DataGridCell>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</ctrl:GroupBox>

		<!-- Archives -->
		<ctrl:GroupBox DataContext="{Binding Game}"
		               Name="ArchivesGroupBox"
		               Grid.Row="1"
		               Grid.Column="1"
		               Header="Archives (BA2)">

			<StackPanel x:DataType="models:Game">
				<Grid Classes="Table"
				      ColumnDefinitions="Auto,Auto,*"
				      RowDefinitions="Auto,Auto,Auto,Auto">

					<ToolTip.Tip>
						<TextBlock>
							<Bold>General/GNRL/Main:</Bold> Used for all non-texture files. Hard limit of
							<Bold>256</Bold> (
							<Bold>1024</Bold> on 1.11.240), after which the game will crash at the main menu.
							<LineBreak />
							<LineBreak />
							<Bold>Texture/DX10:</Bold> Used only for textures. No hard limit, but functional limit is
							<Bold>255</Bold> (
							<Bold>1023</Bold> on 1.11.240), after which the game fails to use correct textures.
							<LineBreak />
							<LineBreak />
							<Bold>Unreadable:</Bold> Files that could not be read due to permissions, unexpected format, or corruption. These are excluded from the counts.
						</TextBlock>
					</ToolTip.Tip>

					<TextBlock Grid.Row="0"
					           Grid.Column="0"
					           Text="General:" />
					<TextBlock Grid.Row="0"
					           Grid.Column="1"
					           Text="{Binding ArchivesGeneral.Count, StringFormat='{}{0,5}'}"
					           ctrl:Status.Level="{Binding ArchivesGeneralStatus}" />
					<TextBlock Grid.Row="0"
					           Grid.Column="2"
					           Text="{Binding MaxArchivesGeneral, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="1"
					           Grid.Column="0"
					           Text="Texture:" />
					<TextBlock Grid.Row="1"
					           Grid.Column="1"
					           Text="{Binding ArchivesTexture.Count, StringFormat='{}{0,5}'}"
					           ctrl:Status.Level="{Binding ArchivesTextureStatus}" />
					<TextBlock Grid.Row="1"
					           Grid.Column="2"
					           Text="{Binding MaxArchivesTexture, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="2"
					           Grid.Column="0"
					           Text="Total:" />
					<TextBlock Grid.Row="2"
					           Grid.Column="1"
					           Text="{Binding TotalArchives, StringFormat='{}{0,5}'}"
					           ctrl:Status.Level="{Binding TotalArchivesStatus}" />
					<TextBlock Grid.Row="2"
					           Grid.Column="2"
					           Text="{Binding TotalArchivesMax, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="3"
					           Grid.Column="0"
					           Text="Unreadable:"
					           Classes="Neutral"
					           Classes.Bad="{Binding HasArchivesUnreadable}" />
					<TextBlock Grid.Row="3"
					           Grid.Column="1"
					           Text="{Binding ArchivesUnreadable.Count, StringFormat='{}{0,5}'}"
					           Classes="Neutral"
					           Classes.Bad="{Binding HasArchivesUnreadable}" />
				</Grid>
				<Grid Classes="Table"
				      ColumnDefinitions="Auto,Auto,*"
				      RowDefinitions="Auto,Auto,Auto,Auto">

					<ToolTip.Tip>
						<TextBlock>
							<Bold>v1:</Bold> Works with all FO4 versions.<LineBreak />
							<LineBreak />
							<Bold>v7/v8:</Bold> <Bold>Next-Gen</Bold> or <Bold>Anniversary</Bold>.<LineBreak />
							<Bold>Old-Gen</Bold> requires <Bold>Backported Archive2 Support System (BASS)</Bold>.
							<LineBreak />
							Some older apps only support <Bold>v1</Bold>.<LineBreak />
							<LineBreak />
							<Bold>v????:</Bold> Archives with an unsupported version.<LineBreak />
							Fallout 4 supports only <Bold>v1</Bold>, <Bold>v7</Bold>, and <Bold>v8</Bold>.<LineBreak />
							<LineBreak />
							Files with other versions were likey made for other games and should be repacked for Fallout 4.
						</TextBlock>
					</ToolTip.Tip>

					<Separator Grid.Row="0"
					           Grid.Column="0"
					           Grid.ColumnSpan="3" />

					<TextBlock Grid.Row="1"
					           Grid.Column="0"
					           Text="(OG) v1   :" />
					<TextBlock Grid.Row="1"
					           Grid.Column="1"
					           Text="{Binding ArchivesOG.Count, StringFormat='{}{0,5}'}" />

					<TextBlock Grid.Row="2"
					           Grid.Column="0"
					           Text="(NG) v7/8 :" />
					<TextBlock Grid.Row="2"
					           Grid.Column="1"
					           Text="{Binding ArchivesNG.Count, StringFormat='{}{0,5}'}" />

					<TextBlock Grid.Row="3"
					           Grid.Column="0"
					           Text="v????:"
					           Classes="Neutral"
					           Classes.Bad="{Binding HasArchivesUnknown}" />
					<TextBlock Grid.Row="3"
					           Grid.Column="1"
					           Text="{Binding ArchivesUnknown.Count, StringFormat='{}{0,5}'}"
					           Classes="Neutral"
					           Classes.Bad="{Binding HasArchivesUnknown}" />
				</Grid>
			</StackPanel>
		</ctrl:GroupBox>

		<!-- Modules -->
		<ctrl:GroupBox DataContext="{Binding Game}"
		               Name="ModulesGroupBox"
		               Grid.Row="2"
		               Grid.Column="1"
		               Header="Modules (ESM/ESL/ESP)">

			<StackPanel x:DataType="models:Game">
				<Grid Classes="Table"
				      ColumnDefinitions="Auto,Auto,*"
				      RowDefinitions="Auto,Auto,Auto,Auto">

					<ToolTip.Tip>
						<TextBlock>
							<Bold>Full modules</Bold> include all non-<Bold>Light</Bold> modules.<LineBreak />
							<Bold>Light modules</Bold> are <Bold>ESL-flagged</Bold> and/or have the <Bold>.esl</Bold>
							extension.
							<LineBreak />
							<LineBreak />
							Light modules give up the capacity to contain more than <Bold>4095</Bold> new records in exchange for having a higher plugin limit.
							<LineBreak />
							<LineBreak />
							<Bold>Unreadable:</Bold> Files that could not be read due to permissions, unexpected format, or corruption. These are excluded from the counts.
						</TextBlock>
					</ToolTip.Tip>

					<TextBlock Grid.Row="0"
					           Grid.Column="0"
					           Text="Full:" />
					<TextBlock Grid.Row="0"
					           Grid.Column="1"
					           Text="{Binding ModulesFull.Count, StringFormat='{}{0,5}'}"
					           ctrl:Status.Level="{Binding ModulesFullStatus}" />
					<TextBlock Grid.Row="0"
					           Grid.Column="2"
					           Text="{Binding MaxModulesFull, StringFormat=' /  {0}'}" />

					<TextBlock Grid.Row="1"
					           Grid.Column="0"
					           Text="Light:" />
					<TextBlock Grid.Row="1"
					           Grid.Column="1"
					           Text="{Binding ModulesLight.Count, StringFormat='{}{0,5}'}"
					           ctrl:Status.Level="{Binding ModulesLightStatus}" />
					<TextBlock Grid.Row="1"
					           Grid.Column="2"
					           Text="{Binding MaxModulesLight, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="2"
					           Grid.Column="0"
					           Text="Total:" />
					<TextBlock Grid.Row="2"
					           Grid.Column="1"
					           Text="{Binding TotalModules, StringFormat='{}{0,5}'}"
					           ctrl:Status.Level="{Binding TotalModulesStatus}" />
					<TextBlock Grid.Row="2"
					           Grid.Column="2"
					           Text="{Binding TotalModulesMax, StringFormat=' / {0}'}" />

					<TextBlock Grid.Row="3"
					           Grid.Column="0"
					           Text="Unreadable:"
					           Classes="Neutral"
					           Classes.Bad="{Binding HasModulesUnreadable}" />
					<TextBlock Grid.Row="3"
					           Grid.Column="1"
					           Text="{Binding ModulesUnreadable.Count, StringFormat='{}{0,5}'}"
					           Classes="Neutral"
					           Classes.Bad="{Binding HasModulesUnreadable}" />
				</Grid>
				<Grid Classes="Table"
				      ColumnDefinitions="Auto,Auto,*"
				      RowDefinitions="Auto,Auto,Auto,Auto">

					<ToolTip.Tip>
						<TextBlock>
							<Bold>Plugin header v1.00</Bold> enables a larger Form ID range than <Bold>v0.95</Bold>.
							<LineBreak />
							Any plugins with IDs below <Bold>800</Bold> <Bold Classes="Caution">MUST</Bold> be
							<Bold>v1.00</Bold>.
							<LineBreak />
							<LineBreak />
							FO4VR only supports <Bold>v0.95</Bold>.<LineBreak />
							<LineBreak />
							In the base game, these 4 modules are <Bold>v0.95</Bold>:<LineBreak />
							• DLCCoast.esm<LineBreak />
							• DLCworkshop02.esm<LineBreak />
							• DLCworkshop03.esm<LineBreak />
							• DLCNukaWorld.esm<LineBreak />
							<LineBreak />
							<Bold>HEDR v????:</Bold> These modules have an unsupported header version.<LineBreak />
							Fallout 4 supports only <Bold>v0.95</Bold> and <Bold>v1.00</Bold>.<LineBreak />
							<LineBreak />
							Files with <Bold Classes="Bad">v0.94</Bold> were likey made with
							<Bold Classes="Bad">FalloutSnip</Bold> and should be replaced, recreated, or removed.
							<LineBreak />
							Use such mods <Bold Classes="Bad">AT YOUR OWN RISK</Bold> as they may result in unknown behavior or issues due to having an invalid structure or corruption.
						</TextBlock>
					</ToolTip.Tip>

					<Separator Grid.Row="0"
					           Grid.Column="0"
					           Grid.ColumnSpan="3" />

					<TextBlock Grid.Row="1"
					           Grid.Column="0"
					           Text="HEDR v1.00:" />
					<TextBlock Grid.Row="1"
					           Grid.Column="1"
					           Text="{Binding Modules100.Count, StringFormat='{}{0,5}'}" />

					<TextBlock Grid.Row="2"
					           Grid.Column="0"
					           Text="HEDR v0.95:" />
					<TextBlock Grid.Row="2"
					           Grid.Column="1"
					           Text="{Binding Modules095.Count, StringFormat='{}{0,5}'}" />

					<TextBlock Grid.Row="3"
					           Grid.Column="0"
					           Text="HEDR v????:"
					           Classes="Neutral"
					           Classes.Bad="{Binding HasModulesUnknown}" />
					<TextBlock Grid.Row="3"
					           Grid.Column="1"
					           Text="{Binding ModulesUnknown.Count, StringFormat='{}{0,5}'}"
					           Classes="Neutral"
					           Classes.Bad="{Binding HasModulesUnknown}" />
				</Grid>
			</StackPanel>
		</ctrl:GroupBox>

		<!-- Issues found while gathering the info above -->
		<ctrl:GroupBox DataContext="{Binding Game}"
		               Grid.Row="1"
		               Grid.RowSpan="2"
		               Grid.Column="2"
		               Header="Issues">

			<Grid RowDefinitions="Auto,*"
			      x:DataType="models:Game">
				<TextBlock Grid.Row="0"
				           Classes="Good"
				           Margin="5"
				           Text="No issues found."
				           IsVisible="{Binding !HasProblems, FallbackValue=False}" />

				<ScrollViewer Grid.Row="1"
				              HorizontalScrollBarVisibility="Disabled"
				              VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding Problems}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="models:ProblemInfo">
								<StackPanel Margin="5,0,5,8"
								            Spacing="1">
									<TextBlock Classes="Readable"
									           TextWrapping="Wrap"
									           ctrl:Status.Level="{Binding Level}">
										<Span Classes="Emoji">
											<Run Text="{Binding SeverityMark}" />
										</Span>
										<Bold>
											<Run Text="{Binding Problem}" />
										</Bold>
									</TextBlock>

									<TextBlock Classes="Readable"
									           TextWrapping="Wrap"
									           Text="{Binding Summary}" />

									<TextBlock Classes="Readable Neutral"
									           TextWrapping="Wrap"
									           Text="{Binding Solution}"
									           IsVisible="{Binding Solution, Converter={x:Static ObjectConverters.IsNotNull}}" />

									<StackPanel Orientation="Horizontal"
									            Spacing="5">
										<Button Content="&#x1F4C2;"
										        Padding="6,0"
										        ToolTip.Tip="Show in Explorer"
										        IsVisible="{Binding HasPath}"
										        Command="{Binding $parent[UserControl].((vm:OverviewViewModel)DataContext).RevealProblemCommand, FallbackValue={x:Null}}"
										        CommandParameter="{Binding}" />
										<Button Content="Open Page"
										        Padding="6,0"
										        ToolTip.Tip="{Binding Url}"
										        IsVisible="{Binding Url, Converter={x:Static ObjectConverters.IsNotNull}}"
										        Command="{Binding $parent[UserControl].((vm:OverviewViewModel)DataContext).OpenProblemUrlCommand, FallbackValue={x:Null}}"
										        CommandParameter="{Binding}" />
									</StackPanel>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</ctrl:GroupBox>

		<ctrl:LoadingOverlay Grid.Row="0"
		                     Grid.RowSpan="3"
		                     Grid.Column="0"
		                     Grid.ColumnSpan="3"
		                     IsVisible="{Binding IsLoading}" />

	</Grid>
</UserControl>
