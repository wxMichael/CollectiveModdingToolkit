<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:CollectiveModdingToolkit.ViewModels"
			 xmlns:conv="using:CollectiveModdingToolkit.Converters"
			 xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
			 mc:Ignorable="d"
			 d:DesignWidth="760"
			 d:DesignHeight="450"
			 x:Class="CollectiveModdingToolkit.Views.TabOverview"
			 x:DataType="vm:MainWindowViewModel">

	<UserControl.Resources>
		<conv:RemoveFileExtConverter x:Key="RemoveFileExtConverter" />
	</UserControl.Resources>

	<Grid ColumnDefinitions="1.1*,*,*"
		  RowDefinitions="Auto, *">
		<Grid Name="OverviewTopPanel"
			  Classes="Table"
			  Grid.Row="0"
			  Grid.Column="0"
			  Grid.ColumnSpan="3"
			  RowDefinitions="Auto,Auto,Auto,Auto"
			  ColumnDefinitions="Auto,*,Auto">
			<TextBlock Grid.Row="0"
					   Grid.Column="0"
					   Text="Mod Manager:" />
			<TextBlock Grid.Row="1"
					   Grid.Column="0"
					   Text="Game Path:" />
			<TextBlock Grid.Row="2"
					   Grid.Column="0"
					   Text="Version:" />
			<TextBlock Grid.Row="3"
					   Grid.Column="0"
					   Text="PC Specs:" />
			<TextBlock Grid.Row="0"
					   Grid.Column="1">
				<Run Text="{Binding ModManager.AppName, Mode=OneWay}" />
				<Run Text="{Binding ModManager.AppVersionString, StringFormat='v{0}'}" />
				<Run Text="{Binding ModManager.Profile, Mode=OneWay,
							 StringFormat='[Profile: {0}]',
							 TargetNullValue='[Profile: Unknown]'}" />
			</TextBlock>
			<TextBlock Grid.Row="1"
					   Grid.Column="1"
					   Text="{Binding Game.GamePath}" />
			<TextBlock Grid.Row="2"
					   Grid.Column="1"
					   Text="{Binding Game.GameVersion}"
					   Classes="Good" />
			<Grid Grid.Row="3"
				  Grid.Column="1"
				  RowDefinitions="Auto,Auto"
				  ColumnDefinitions="*,*">
				<TextBlock Grid.Row="0"
						   Grid.Column="0">
					<Run Text="{Binding Computer.Os}" />
					<Run Text="{Binding Computer.Bits, StringFormat='{}{0}-bit'}" />
				</TextBlock>
				<TextBlock Grid.Row="1"
						   Grid.Column="0"
						   Text="{Binding Computer.Ram, StringFormat='{}{0} GB RAM', Mode=OneWay}" />
				<TextBlock Grid.Row="0"
						   Grid.Column="1"
						   Text="{Binding Computer.Cpu}" />
				<TextBlock Grid.Row="1"
						   Grid.Column="1">
					<Run Text="{Binding Computer.Gpu}" />
					<Run Text="{Binding Computer.Vram, StringFormat='{}{0} GB', Mode=OneWay}" />
				</TextBlock>
			</Grid>
			<Button Grid.Row="0"
					Grid.Column="2"
					Grid.RowSpan="2"
					Command="{Binding RefreshCommand}">Refresh</Button>
		</Grid>
		<ctrl:GroupBox Grid.Row="1"
					   Grid.Column="0"
					   Header="Binaries (EXE/DLL/BIN)">

			<DataGrid Name="BinariesList"
					  DockPanel.Dock="Right"
					  ItemsSource="{Binding Game.Binaries}"
					  AutoGenerateColumns="False"
					  IsReadOnly="True"
					  CanUserResizeColumns="False"
					  CanUserSortColumns="False"
					  HeadersVisibility="None">

				<DataGrid.Columns>
					<DataGridTemplateColumn Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<DataGridCell PointerPressed="BinariesList_PointerPressed"
											  PointerEntered="BinariesList_PointerEntered"
											  PointerExited="BinariesList_PointerExited">
									<TextBlock Text="{Binding Name, StringFormat='{}{0}:', Converter={StaticResource RemoveFileExtConverter}}"
											   VerticalAlignment="Center"
											   HorizontalAlignment="Right"
											   Classes="Small" />
								</DataGridCell>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn Width="Auto">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<DataGridCell PointerPressed="BinariesList_PointerPressed"
											  PointerEntered="BinariesList_PointerEntered"
											  PointerExited="BinariesList_PointerExited">
									<TextBlock Text="{Binding DisplayText}"
											   VerticalAlignment="Center"
											   HorizontalAlignment="Left"
											   Classes="Small"
											   Classes.Good="{Binding IsGood}"
											   Classes.Bad="{Binding !IsGood}" />
									<!--IsVisible="{Binding IsGood, Converter={x:Static ObjectConverters.IsNotNull}}" />-->
								</DataGridCell>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

				</DataGrid.Columns>
			</DataGrid>

		</ctrl:GroupBox>
		<ctrl:GroupBox Grid.Row="1"
					   Grid.Column="1"
					   Header="Archives (BA2)">
			<Grid Classes="Table"
				  ColumnDefinitions="Auto,Auto,*"
				  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
				<TextBlock Grid.Row="0"
						   Grid.Column="0"
						   Text="General:" />
				<TextBlock Grid.Row="0"
						   Grid.Column="1"
						   Text="{Binding Game.ArchivesGeneral.Count, StringFormat='{}{0,4}'}"
						   Classes="Good"
						   Classes.Warning="{Binding Game.ArchivesGeneralWarning}"
						   Classes.Bad="{Binding Game.ArchivesGeneralMaxed}" />
				<TextBlock Grid.Row="0"
						   Grid.Column="2"
						   Text="{Binding Game.MaxArchives, StringFormat=' / {0}'}" />

				<TextBlock Grid.Row="1"
						   Grid.Column="0"
						   Text="Texture:" />
				<TextBlock Grid.Row="1"
						   Grid.Column="1"
						   Text="{Binding Game.ArchivesTexture.Count, StringFormat='{}{0,4}'}"
						   Classes="Good"
						   Classes.Warning="{Binding Game.ArchivesTextureWarning}"
						   Classes.Bad="{Binding Game.ArchivesTextureMaxed}" />
				<TextBlock Grid.Row="1"
						   Grid.Column="2"
						   Text="{Binding Game.MaxArchives, StringFormat=' / {0}'}" />

				<TextBlock Grid.Row="2"
						   Grid.Column="0"
						   Text="Total:" />
				<TextBlock Grid.Row="2"
						   Grid.Column="1"
						   Text="{Binding Game.TotalArchives, StringFormat='{}{0,4}'}"
						   Classes="Good"
						   Classes.Warning="{Binding Game.TotalArchivesWarning}"
						   Classes.Bad="{Binding Game.TotalArchivesMaxed}" />
				<TextBlock Grid.Row="2"
						   Grid.Column="2"
						   Text="{Binding Game.TotalArchivesMax, StringFormat=' / {0}'}" />

				<TextBlock Grid.Row="3"
						   Grid.Column="0"
						   Text="Unreadable:"
						   Classes="Neutral"
						   Classes.Bad="{Binding Game.HasArchivesUnreadable}" />
				<TextBlock Grid.Row="3"
						   Grid.Column="1"
						   Text="{Binding Game.ArchivesUnreadable.Count, StringFormat='{}{0,4}'}"
						   Classes="Neutral"
						   Classes.Bad="{Binding Game.HasArchivesUnreadable}" />

				<Separator Grid.Row="4"
						   Grid.Column="0"
						   Grid.ColumnSpan="3" />

				<TextBlock Grid.Row="5"
						   Grid.Column="0"
						   Text="(OG) v1   :" />
				<TextBlock Grid.Row="5"
						   Grid.Column="1"
						   Text="{Binding Game.ArchivesOG.Count, StringFormat='{}{0,4}'}" />

				<TextBlock Grid.Row="6"
						   Grid.Column="0"
						   Text="(NG) v7/8 :" />
				<TextBlock Grid.Row="6"
						   Grid.Column="1"
						   Text="{Binding Game.ArchivesNG.Count, StringFormat='{}{0,4}'}" />

				<TextBlock Grid.Row="7"
						   Grid.Column="0"
						   Text="v????:"
						   Classes="Neutral"
						   Classes.Bad="{Binding Game.HasArchivesUnknown}" />
				<TextBlock Grid.Row="7"
						   Grid.Column="1"
						   Text="{Binding Game.ArchivesUnknown.Count, StringFormat='{}{0,4}'}"
						   Classes="Neutral"
						   Classes.Bad="{Binding Game.HasArchivesUnknown}" />
			</Grid>
		</ctrl:GroupBox>
		<ctrl:GroupBox Grid.Row="1"
					   Grid.Column="2"
					   Header="Modules (ESM/ESL/ESP)">
			<Grid Classes="Table"
				  ColumnDefinitions="Auto,Auto,*"
				  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
				  Margin="0">
				<TextBlock Grid.Row="0"
						   Grid.Column="0"
						   Text="Full:" />
				<TextBlock Grid.Row="0"
						   Grid.Column="1"
						   Text="{Binding Game.ModulesFull.Count, StringFormat='{}{0,5}'}"
						   Classes="Good"
						   Classes.Warning="{Binding Game.ModulesFullWarning}"
						   Classes.Bad="{Binding Game.ModulesFullMaxed}" />
				<TextBlock Grid.Row="0"
						   Grid.Column="2"
						   Text="{Binding Game.MaxModulesFull, StringFormat=' /  {0}'}" />

				<TextBlock Grid.Row="1"
						   Grid.Column="0"
						   Text="Light:" />
				<TextBlock Grid.Row="1"
						   Grid.Column="1"
						   Text="{Binding Game.ModulesLight.Count, StringFormat='{}{0,5}'}"
						   Classes="Good"
						   Classes.Warning="{Binding Game.ModulesLightWarning}"
						   Classes.Bad="{Binding Game.ModulesLightMaxed}" />
				<TextBlock Grid.Row="1"
						   Grid.Column="2"
						   Text="{Binding Game.MaxModulesLight, StringFormat=' / {0}'}" />

				<TextBlock Grid.Row="2"
						   Grid.Column="0"
						   Text="Total:" />
				<TextBlock Grid.Row="2"
						   Grid.Column="1"
						   Text="{Binding Game.TotalModules, StringFormat='{}{0,5}'}"
						   Classes="Good"
						   Classes.Warning="{Binding Game.TotalModulesWarning}"
						   Classes.Bad="{Binding Game.TotalModulesMaxed}" />
				<TextBlock Grid.Row="2"
						   Grid.Column="2"
						   Text="{Binding Game.TotalModulesMax, StringFormat=' / {0}'}" />

				<TextBlock Grid.Row="3"
						   Grid.Column="0"
						   Text="Unreadable:"
						   Classes="Neutral"
						   Classes.Bad="{Binding Game.HasModulesUnreadable}" />
				<TextBlock Grid.Row="3"
						   Grid.Column="1"
						   Text="{Binding Game.ModulesUnreadable.Count, StringFormat='{}{0,5}'}"
						   Classes="Neutral"
						   Classes.Bad="{Binding Game.HasModulesUnreadable}" />

				<Separator Grid.Row="4"
						   Grid.Column="0"
						   Grid.ColumnSpan="3" />

				<TextBlock Grid.Row="5"
						   Grid.Column="0"
						   Text="HEDR v1.00:" />
				<TextBlock Grid.Row="5"
						   Grid.Column="1"
						   Text="{Binding Game.Modules100.Count, StringFormat='{}{0,5}'}" />

				<TextBlock Grid.Row="6"
						   Grid.Column="0"
						   Text="HEDR v0.95:" />
				<TextBlock Grid.Row="6"
						   Grid.Column="1"
						   Text="{Binding Game.Modules095.Count, StringFormat='{}{0,5}'}" />

				<TextBlock Grid.Row="7"
						   Grid.Column="0"
						   Text="HEDR v????:"
						   Classes="Neutral"
						   Classes.Bad="{Binding Game.HasModulesUnknown}" />
				<TextBlock Grid.Row="7"
						   Grid.Column="1"
						   Text="{Binding Game.ModulesUnknown.Count, StringFormat='{}{0,5}'}"
						   Classes="Neutral"
						   Classes.Bad="{Binding Game.HasModulesUnknown}" />
			</Grid>
		</ctrl:GroupBox>
	</Grid>
</UserControl>
