<!-- Covers its parent's content with a dimmed layer and a spinner. Place last in a Grid/Panel and bind IsVisible. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CollectiveModdingToolkit.Controls.LoadingOverlay">

	<UserControl.Styles>
		<Style Selector="ProgressBar.Ring /template/ Border#PART_Indicator">
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</UserControl.Styles>

	<!-- Opaque to input so the content underneath can't be clicked while loading. -->
	<Border Background="{DynamicResource BgBrush}"
	        Opacity="0.85">

		<ProgressBar Classes="Ring"
		             Theme="{DynamicResource ProgressRing}"
		             IsIndeterminate="True"
		             Width="48"
		             Height="48"
		             HorizontalAlignment="Center"
		             VerticalAlignment="Center" />

	</Border>
</UserControl>
