<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia">

	<Style Selector="Button">
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		<Setter Property="FontFamily" Value="{StaticResource CascadiaMono}" />
		<Setter Property="Padding" Value="5" />
	</Style>

	<!-- Accent-filled buttons may need dark text; computed per accent (OnAccentColor) -->
	<Style Selector="Button.Primary">
		<Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
	</Style>

	<!-- Semi defines Danger; declared empty here so the IDE recognizes the class -->
	<Style Selector="Button.Danger" />

	<!-- Colors come from the HyperlinkButton* keys in Theme/SemiOverrides.axaml -->
	<Style Selector="HyperlinkButton">
		<Setter Property="Padding" Value="0" />
		<Setter Property="FontFamily" Value="{StaticResource Readable}" />
	</Style>

	<Style Selector="ProgressBar">
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="ProgressBar /template/ Border#PART_Indicator">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
	</Style>

	<Style Selector="RadioButton">
		<Setter Property="FontWeight" Value="Normal" />
	</Style>

	<Style Selector="Separator">
		<Setter Property="Background" Value="{DynamicResource StrokeMidBrush}" />
		<Setter Property="Height" Value="2" />
	</Style>

	<Style Selector="Border#CriticalErrorContent">
		<Setter Property="BorderBrush" Value="{DynamicResource StrokeBrightBrush}" />
		<Setter Property="BorderThickness" Value="2" />
		<Setter Property="Padding" Value="5" />
		<Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
	</Style>

	<Style Selector="dialogHost|DialogHost">
		<Setter Property="DialogMargin" Value="0" />
	</Style>

	<Style Selector="Expander:down /template/ ToggleButton#ExpanderHeader">
		<Setter Property="Padding" Value="0" />
	</Style>
	<Style Selector="Expander:down /template/ LayoutTransformControl#ExpanderHeaderLayoutContainer">
		<Setter Property="Margin" Value="0" />
	</Style>
</Styles>
