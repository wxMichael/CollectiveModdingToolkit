<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia">

	<Style Selector="Button">
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		<Setter Property="FontFamily" Value="{StaticResource CascadiaMono}" />
		<Setter Property="Padding" Value="5" />
	</Style>

	<!-- Accent-filled buttons may need dark text; computed per accent (OnAccentColor) -->
	<Style Selector="Button.Primary">
		<Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
	</Style>

	<!-- Text-style link button, colored with the accent -->
	<Style Selector="Button.Link">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		<Setter Property="FontFamily" Value="{StaticResource Readable}" />
		<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="TextBlock.TextDecorations" Value="Underline" />
		</Style>
		<Style Selector="^:pointerover, ^:pressed">
			<Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
			<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
				<Setter Property="Background" Value="Transparent" />
			</Style>
		</Style>
	</Style>

	<Style Selector="ProgressBar">
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="ProgressBar /template/ Border#PART_Indicator">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
	</Style>

	<Style Selector="RadioButton">
		<Setter Property="FontWeight" Value="Normal" />
	</Style>

	<Style Selector="Separator">
		<Setter Property="Background" Value="{DynamicResource StrokeMidBrush}" />
		<Setter Property="Height" Value="2" />
	</Style>

	<Style Selector="Border#CriticalErrorContent">
		<Setter Property="BorderBrush" Value="{DynamicResource StrokeBrightBrush}" />
		<Setter Property="BorderThickness" Value="2" />
		<Setter Property="Padding" Value="5" />
		<Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
	</Style>

	<Style Selector="dialogHost|DialogHost">
		<Setter Property="DialogMargin" Value="0" />
	</Style>

	<Style Selector="Expander:down /template/ ToggleButton#ExpanderHeader">
		<Setter Property="Padding" Value="0" />
	</Style>
	<Style Selector="Expander:down /template/ LayoutTransformControl#ExpanderHeaderLayoutContainer">
		<Setter Property="Margin" Value="0" />
	</Style>
</Styles>
