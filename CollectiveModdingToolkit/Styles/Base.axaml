<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:CollectiveModdingToolkit.Controls">

	<Style Selector="Window">
		<Setter Property="Background" Value="{DynamicResource BgBrush}" />
	</Style>

	<Style Selector="ctrl|GroupBox">
		<Setter Property="Margin" Value="2" />
	</Style>

	<!-- Mouseover hitbox workaround: transparent (not null) backgrounds so empty areas still receive pointer events -->
	<Style Selector="ctrl|GroupBox">
		<Setter Property="Background" Value="Transparent" />
	</Style>
	<Style Selector="Grid">
		<Setter Property="Background" Value="Transparent" />
	</Style>
	<Style Selector="TextBlock">
		<Setter Property="Background" Value="Transparent" />
	</Style>

	<Style Selector="Span.Emoji">
		<Setter Property="FontFamily" Value="{StaticResource Icomoon}" />
	</Style>

	<Style Selector="Grid.HighlightBG">
		<Setter Property="Background" Value="{DynamicResource HighlightBrush}" />
	</Style>

	<!-- Tooltips -->
	<Style Selector=":is(Control)">
		<Setter Property="ToolTip.Placement" Value="Pointer" />
		<Setter Property="ToolTip.ShowDelay" Value="200" />
		<Setter Property="ToolTip.BetweenShowDelay" Value="0" />
		<Setter Property="ToolTip.HorizontalOffset" Value="15" />
		<Setter Property="ToolTip.VerticalOffset" Value="10" />
	</Style>

	<Style Selector="ToolTip, FlyoutPresenter">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Transitions" Value="" />
		<Setter Property="Background" Value="{DynamicResource BgTooltipBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource NeutralBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Style Selector="^ TextBlock">
			<Setter Property="FontFamily" Value="{StaticResource Readable}" />
			<Setter Property="FontSize" Value="{StaticResource Small}" />
			<Setter Property="FontWeight" Value="SemiLight" />
			<Setter Property="Foreground" Value="{DynamicResource Neutral2Brush}" />
			<Setter Property="TextAlignment" Value="Left" />

			<Style Selector="^ Bold">
				<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
				<Setter Property="FontFamily" Value="{StaticResource CascadiaMono}" />
				<Setter Property="FontWeight" Value="Normal" />
			</Style>
		</Style>
	</Style>
</Styles>
