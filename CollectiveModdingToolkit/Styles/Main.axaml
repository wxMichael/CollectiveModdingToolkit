<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ac="using:Avalonia.Controls.Presenters"
		xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
		xmlns:ctrl="using:CollectiveModdingToolkit.Controls"
		xmlns:tips="clr-namespace:CollectiveModdingToolkit.Models.Tooltips">
	<Design.PreviewWith>
		<Border Padding="20" />
	</Design.PreviewWith>

	<Styles.Resources>
		<StaticResource x:Key="DefaultBG"
						ResourceKey="Grey0"/>
		<StaticResource x:Key="LightBG"
						ResourceKey="Grey1"/>
		<StaticResource x:Key="DefaultFG"
						ResourceKey="Grey11"/>

		<Color x:Key="Neutral">Gray</Color>
		<Color x:Key="Neutral2">#FFE4C4</Color>
		<Color x:Key="Good">LimeGreen</Color>
		<Color x:Key="Bad">Tomato</Color>
		<Color x:Key="Caution">Yellow</Color>
		<Color x:Key="Warning">Orange</Color>
		<!--0094FF-->
		<!--<Color x:Key="Blue">#3D9EFF</Color>
		<Color x:Key="Purple">#9A75FF</Color>-->
		<Color x:Key="Blue">CadetBlue</Color>
		<Color x:Key="Purple">MediumPurple</Color>
		<FontFamily x:Key="Readable">Bahnschrift</FontFamily>
		<x:Double x:Key="Small">14</x:Double>
		<x:Double x:Key="Smaller">12</x:Double>
		<x:Double x:Key="Smallest">11</x:Double>
	</Styles.Resources>

	<!-- Defaults -->
	<Style Selector="Window">
		<Setter Property="Background"
				Value="{StaticResource Grey0}" />
	</Style>

	<Style Selector="ctrl|GroupBox">
		<Setter Property="Margin"
				Value="2" />
	</Style>



	<Style Selector="TextBlock:not(#GBHeaderText)">
		<Setter Property="FontFamily"
				Value="{StaticResource CascadiaMono}" />
		<Setter Property="FontSize"
				Value="16" />
		<Setter Property="Foreground"
				Value="{StaticResource DefaultFG}" />

		<!-- Mouseover Hitbox Workaround -->
		<Setter Property="Background"
				Value="Transparent" />
	</Style>



	<!-- Mouseover Hitbox Workaround -->
	<Style Selector="ctrl|GroupBox">
		<Setter Property="Background"
				Value="Transparent" />
	</Style>
	<Style Selector="Grid">
		<Setter Property="Background"
				Value="Transparent" />
	</Style>
	<Style Selector="TextBlock">
		<Setter Property="Background"
				Value="Transparent" />
	</Style>




	<!-- Tabs -->
	<Style Selector="TabControl /template/ WrapPanel">
		<Setter Property="Background"
				Value="{StaticResource Blackish}" />
	</Style>

	<Style Selector="TabItem:nth-child(1)">
		<Setter Property="Margin"
				Value="2,0,0,0" />
	</Style>

	<Style Selector="TabItem:not(:selected) /template/ Border#PART_LayoutRoot">
		<Setter Property="CornerRadius"
				Value="5,0" />
		<Setter Property="Margin"
				Value="2,3,0,0" />
		<Setter Property="Background"
				Value="{StaticResource Grey1}" />
		<Setter Property="BorderThickness"
				Value="1,1,1,0" />
		<Setter Property="BorderBrush"
				Value="{StaticResource Grey2}" />
	</Style>

	<Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
		<Setter Property="CornerRadius"
				Value="5,0" />
		<Setter Property="Margin"
				Value="2,3,0,0" />
		<Setter Property="Background"
				Value="{StaticResource Grey2}" />
		<Setter Property="BorderThickness"
				Value="1,1,1,0" />
		<Setter Property="BorderBrush"
				Value="{StaticResource Grey3}" />
	</Style>

	<Style Selector="TabItem:not(:selected) /template/ Border#PART_SelectedPipe">
		<Setter Property="Background"
				Value="{StaticResource SemiLime9}" />
	</Style>

	<Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
		<Setter Property="Background"
				Value="{StaticResource SemiLime6}" />
	</Style>

	<Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
		<Setter Property="Padding"
				Value="5" />
	</Style>


	<!-- Group Boxes -->
	<Style Selector="Label#GBHeaderText">
		<Setter Property="FontFamily"
				Value="{StaticResource CascadiaMono}" />
		<Setter Property="FontSize"
				Value="12" />
	</Style>

	<Style Selector="TextBlock#GBHeaderText">
		<Setter Property="FontFamily"
				Value="{StaticResource CascadiaMono}" />
		<Setter Property="FontSize"
				Value="12" />
	</Style>

	<Style Selector="Span.Emoji">
		<Setter Property="FontFamily"
				Value="{StaticResource icomoon}" />
	</Style>

	<Style Selector="Button">
		<Setter Property="Foreground"
				Value="{StaticResource DefaultFG}" />
		<Setter Property="FontFamily"
				Value="{StaticResource CascadiaMono}" />
	</Style>

	<Style Selector="Separator">
		<Setter Property="Background"
				Value="Gray" />
		<Setter Property="Height"
				Value="2" />
	</Style>

	<Style Selector="Span.Neutral">
		<Setter Property="Foreground"
				Value="{StaticResource Neutral}" />
	</Style>

	<Style Selector="Span.Neutral2">
		<Setter Property="Foreground"
				Value="{StaticResource Neutral2}" />
	</Style>

	<Style Selector="Span.Good">
		<Setter Property="Foreground"
				Value="{StaticResource Good}" />
	</Style>

	<Style Selector="Span.Caution">
		<Setter Property="Foreground"
				Value="{StaticResource Caution}" />
	</Style>

	<Style Selector="Border#CriticalErrorContent">
		<Setter Property="BorderBrush"
				Value="#BBB" />
		<Setter Property="BorderThickness"
				Value="2" />
		<Setter Property="Padding"
				Value="5" />
		<Setter Property="Background"
				Value="{StaticResource Grey1}" />
	</Style>

	<Style Selector="Run.Bad">
		<Setter Property="Foreground"
				Value="{StaticResource Bad}" />
	</Style>

	<Style Selector="Span.Bad">
		<Setter Property="Foreground"
				Value="{StaticResource Bad}" />
	</Style>

	<Style Selector="dialogHost|DialogHost">
		<Setter Property="DialogMargin"
				Value="0" />
	</Style>

	<Style Selector="Grid.HighlightBG">
		<Setter Property="Background"
				Value="#16FFFFFF" />
	</Style>

	<Style Selector="Grid.HighlightBG">
		<Setter Property="Background"
				Value="#16FFFFFF" />
	</Style>

	<Styles.Resources>
		<x:Double x:Key="DataGridCellMinHeight">24</x:Double>
	</Styles.Resources>

	<Style Selector="DataGridCell">
		<Setter Property="Padding"
				Value="0" />
	</Style>

	<!--<Style Selector="DataGridRow">
		<Setter Property="Padding"
				Value="5" />
	</Style>-->

	<Style Selector="DataGrid#GameBinariesList, DataGrid#CKBinariesList, DataGrid#F4SEDLLsList">
		<Style.Resources>
			<x:Double x:Key="DataGridCellMinHeight">28</x:Double>
		</Style.Resources>
		<Style Selector="^ DataGridCell">
			<Setter Property="Padding"
					Value="0,2,0,0" />
			<Setter Property="MinHeight"
					Value="0" />
			<Style Selector="^:selected /template/ Rectangle">
				<Setter Property="Stroke"
						Value="" />
			</Style>
			<Style Selector="^:current /template/ Rectangle">
				<Setter Property="Stroke"
						Value="" />
			</Style>
		</Style>
		<Style Selector="^ /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
			<Setter Property="IsVisible"
					Value="False" />
		</Style>
		<Style Selector="^ DataGridRow:pointerover /template/ Border#BackgroundBorder">
			<Setter Property="Background"
					Value="Transparent" />
		</Style>
		<Style Selector="^ DataGridRow:selected /template/ Border#BackgroundBorder">
			<Setter Property="Background"
					Value="Transparent" />
			<Setter Property="CornerRadius"
					Value="0" />
			<Setter Property="Margin"
					Value="0" />
		</Style>
	</Style>

	<!-- Fonts -->
	<Style Selector=":is(TextElement)">
		<Style Selector="^.Readable">
			<Setter Property="FontFamily"
					Value="{StaticResource Readable}" />
			<Setter Property="FontSize"
					Value="{StaticResource Small}" />
		</Style>

		<Style Selector="^.Small">
			<Setter Property="FontSize"
					Value="{StaticResource Small}" />
		</Style>

		<Style Selector="^.Smaller">
			<Setter Property="FontSize"
					Value="{StaticResource Smaller}" />
		</Style>

		<Style Selector="^.Smallest">
			<Setter Property="FontSize"
					Value="{StaticResource Smallest}" />
		</Style>


		<Style Selector="^.Neutral">
			<Setter Property="Foreground"
					Value="{StaticResource Neutral}" />
		</Style>

		<Style Selector="^.Neutral2">
			<Setter Property="Foreground"
					Value="{StaticResource Neutral2}" />
		</Style>

		<Style Selector="^.Good">
			<Setter Property="Foreground"
					Value="{StaticResource Good}" />
		</Style>

		<Style Selector="^.Caution">
			<Setter Property="Foreground"
					Value="{StaticResource Caution}" />
		</Style>

		<Style Selector="^.Warning">
			<Setter Property="Foreground"
					Value="{StaticResource Warning}" />
		</Style>

		<Style Selector="^.Bad">
			<Setter Property="Foreground"
					Value="{StaticResource Bad}" />
		</Style>

		<Style Selector="^.Blue">
			<Setter Property="Foreground"
					Value="{StaticResource Blue}" />
		</Style>

		<Style Selector="^.Purple">
			<Setter Property="Foreground"
					Value="{StaticResource Purple}" />
		</Style>
	</Style>

	<Style Selector="TextBlock:not(#GBHeaderText)">
		<Style Selector="^.Readable">
			<Setter Property="FontFamily"
					Value="{StaticResource Readable}" />
			<Setter Property="FontSize"
					Value="{StaticResource Small}" />
		</Style>

		<Style Selector="^.Small">
			<Setter Property="FontSize"
					Value="{StaticResource Small}" />
		</Style>

		<Style Selector="^.Smaller">
			<Setter Property="FontSize"
					Value="{StaticResource Smaller}" />
		</Style>

		<Style Selector="^.Smallest">
			<Setter Property="FontSize"
					Value="{StaticResource Smallest}" />
		</Style>

		<Style Selector="^.Neutral">
			<Setter Property="Foreground"
					Value="{StaticResource Neutral}" />
		</Style>

		<Style Selector="^.Neutral2">
			<Setter Property="Foreground"
					Value="{StaticResource Neutral2}" />
		</Style>

		<Style Selector="^.Good">
			<Setter Property="Foreground"
					Value="{StaticResource Good}" />
		</Style>

		<Style Selector="^.Caution">
			<Setter Property="Foreground"
					Value="{StaticResource Caution}" />
		</Style>

		<Style Selector="^.Warning">
			<Setter Property="Foreground"
					Value="{StaticResource Warning}" />
		</Style>

		<Style Selector="^.Bad">
			<Setter Property="Foreground"
					Value="{StaticResource Bad}" />
		</Style>

		<Style Selector="^.Blue">
			<Setter Property="Foreground"
					Value="{StaticResource Blue}" />
		</Style>

		<Style Selector="^.Purple">
			<Setter Property="Foreground"
					Value="{StaticResource Purple}" />
		</Style>
	</Style>

	<!-- ToolTips -->
	<Style Selector=":is(Control)">
		<Setter Property="ToolTip.Placement"
				Value="Pointer" />
		<Setter Property="ToolTip.ShowDelay"
				Value="200" />
		<Setter Property="ToolTip.BetweenShowDelay"
				Value="0" />
		<Setter Property="ToolTip.HorizontalOffset"
				Value="15" />
		<Setter Property="ToolTip.VerticalOffset"
				Value="10" />
	</Style>

	<Style Selector="ToolTip, FlyoutPresenter">
		<Setter Property="MinHeight"
				Value="0" />
		<Setter Property="Transitions"
				Value="" />
		<Setter Property="Background"
				Value="{StaticResource Grey4}" />
		<Setter Property="BorderBrush"
				Value="{StaticResource Neutral}" />
		<Setter Property="BorderThickness"
				Value="1" />
		<Style Selector="^ TextBlock">
			<Setter Property="FontFamily"
					Value="{StaticResource Readable}" />
			<Setter Property="FontSize"
					Value="{StaticResource Small}" />
			<Setter Property="FontWeight"
					Value="SemiLight" />
			<Setter Property="Foreground"
					Value="{StaticResource Neutral2}" />
			<Setter Property="TextAlignment"
					Value="Left" />

			<Style Selector="^ Bold">
				<Setter Property="Foreground"
						Value="{StaticResource DefaultFG}" />
				<Setter Property="FontFamily"
						Value="{StaticResource CascadiaMono}" />
				<Setter Property="FontSize"
						Value="{StaticResource Smaller}" />
				<Setter Property="FontWeight"
						Value="Normal" />

				<Style Selector="^ > Run">
					<Setter Property="BaselineAlignment"
							Value="Bottom" />
				</Style>
			</Style>
		</Style>
	</Style>

	<Style Selector="Button">
		<Setter Property="Padding"
				Value="5" />
	</Style>
	<Style Selector="RadioButton">
		<Setter Property="FontWeight"
				Value="Normal" />
	</Style>


	<Style Selector="Expander:down /template/ ToggleButton#ExpanderHeader">
		<Setter Property="Padding"
				Value="0" />
	</Style>
	<Style Selector="Expander:down /template/ LayoutTransformControl#ExpanderHeaderLayoutContainer">
		<Setter Property="Margin"
				Value="0" />
	</Style>


	<Style Selector="DataGridRow:pointerover /template/ Border#BackgroundBorder">
		<Setter Property="Background"
				Value="Transparent" />
	</Style>


</Styles>
