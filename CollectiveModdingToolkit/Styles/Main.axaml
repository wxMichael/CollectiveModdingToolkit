<!-- Aggregates the per-area style files. Palette, brushes, and metrics live in Theme/. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20" />
	</Design.PreviewWith>

	<!-- Text must come before Base: Base's ToolTip TextBlock/Bold rules need to override Text's TextBlock defaults (later wins) -->
	<StyleInclude Source="avares://CollectiveModdingToolkit/Styles/Text.axaml" />
	<StyleInclude Source="avares://CollectiveModdingToolkit/Styles/Base.axaml" />
	<StyleInclude Source="avares://CollectiveModdingToolkit/Styles/Tabs.axaml" />
	<StyleInclude Source="avares://CollectiveModdingToolkit/Styles/Controls.axaml" />
	<StyleInclude Source="avares://CollectiveModdingToolkit/Styles/DataGrid.axaml" />
</Styles>
