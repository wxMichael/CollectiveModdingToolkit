<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Style Selector="TabControl /template/ WrapPanel">
		<Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
	</Style>

	<Style Selector="TabItem:nth-child(1)">
		<Setter Property="Margin" Value="2,0,0,0" />
	</Style>

	<!-- The accent underline is themed via the TabItemLinePipe* keys in Theme/SemiOverrides.axaml -->

	<Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
		<Setter Property="Padding" Value="5" />
	</Style>
</Styles>
