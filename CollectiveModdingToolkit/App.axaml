<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             x:Class="CollectiveModdingToolkit.App"
             RequestedThemeVariant="Dark">

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://CollectiveModdingToolkit/Theme/Colors.axaml" />
				<ResourceInclude Source="avares://CollectiveModdingToolkit/Theme/Brushes.axaml" />
				<ResourceInclude Source="avares://CollectiveModdingToolkit/Theme/Metrics.axaml" />
				<ResourceInclude Source="avares://CollectiveModdingToolkit/Theme/SemiOverrides.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<dialogHostAvalonia:DialogHostStyles />
		<semi:SemiTheme Locale="en-US" />
		<StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />
		<StyleInclude Source="Styles/Main.axaml" />
	</Application.Styles>
</Application>
