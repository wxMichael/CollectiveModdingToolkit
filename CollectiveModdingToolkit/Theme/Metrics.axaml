<!-- Fonts, sizes and spacing. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<FontFamily x:Key="CascadiaMono">avares://CollectiveModdingToolkit/Assets/Fonts#Cascadia Mono Light</FontFamily>
	<FontFamily x:Key="Icomoon">avares://CollectiveModdingToolkit/Assets/Fonts#icomoon</FontFamily>
	<FontFamily x:Key="Readable">Bahnschrift</FontFamily>

	<x:Double x:Key="FontSizeBase">16</x:Double>
	<x:Double x:Key="Small">14</x:Double>
	<x:Double x:Key="Smaller">12</x:Double>
	<x:Double x:Key="Smallest">11</x:Double>

	<x:Double x:Key="DataGridCellMinHeight">24</x:Double>

</ResourceDictionary>
