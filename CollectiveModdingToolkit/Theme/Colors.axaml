<!-- Raw palette. Nothing in Views/ or Styles/ should reference these directly: use the semantic brushes in Brushes.axaml. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Neutral ramp -->
	<Color x:Key="Blackish">#0D0D0D</Color>
	<Color x:Key="Grey0">#1C1C1C</Color>
	<Color x:Key="Grey1">#2B2B2B</Color>
	<Color x:Key="Grey2">#3A3A3A</Color>
	<Color x:Key="Grey3">#494949</Color>
	<Color x:Key="Grey4">#585858</Color>
	<Color x:Key="Grey5">#676767</Color>
	<Color x:Key="Grey6">#767676</Color>
	<Color x:Key="Grey7">#858585</Color>
	<Color x:Key="Grey8">#949494</Color>
	<Color x:Key="Grey9">#A3A3A3</Color>
	<Color x:Key="Grey10">#B2B2B2</Color>
	<Color x:Key="Grey11">#C0C0C0</Color>
	<Color x:Key="HighlightColor">#16FFFFFF</Color>
	<Color x:Key="StrokeMidColor">#808080</Color>
	<Color x:Key="StrokeBrightColor">#BBBBBB</Color>

	<!-- Status colors. Swap these (see ThemeService.SetColor) for accessibility schemes. -->
	<Color x:Key="NeutralColor">Gray</Color>
	<Color x:Key="Neutral2Color">#FFE4C4</Color>
	<Color x:Key="GoodColor">LimeGreen</Color>
	<Color x:Key="BadColor">Tomato</Color>
	<!-- Dim variants are derived from Good/Bad by ThemeService (70% toward black); these are the matching defaults -->
	<Color x:Key="GoodDimColor">#0F3E0F</Color>
	<Color x:Key="BadDimColor">#4D1E15</Color>
	<Color x:Key="CautionColor">Goldenrod</Color>
	<Color x:Key="WarningColor">Orange</Color>
	<Color x:Key="BlueColor">CadetBlue</Color>
	<Color x:Key="PurpleColor">MediumPurple</Color>

	<!--
		Accent. These are the Fallout 4 defaults.
		ThemeService overwrites them at runtime for the active game and derives Hover/Active/Dim/Tint/On.
	-->
	<Color x:Key="AccentColor">#05B62E</Color>
	<Color x:Key="AccentBrightColor">#57FF64</Color>
	<Color x:Key="AccentHoverColor">#2BC14D</Color>
	<Color x:Key="AccentActiveColor">#049225</Color>
	<Color x:Key="AccentDimColor">#024010</Color>
	<Color x:Key="AccentTintColor">#3305B62E</Color>
	<Color x:Key="OnAccentColor">#0D0D0D</Color>

</ResourceDictionary>
